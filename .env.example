NODE_ENV=development
# triprep-api belegt auf dem VPS bereits Port 3000
PORT=3010
# Hinter Nginx nur intern lauschen
HOST=127.0.0.1
BASE_URL=http://localhost:3010
DATABASE_URL=postgres://user:password@localhost:5432/trihotel
SESSION_SECRET=change-me

# Mail (Anbieter noch offen, EU-Standort) – 'console' schreibt nur ins Log, 'smtp' versendet
MAIL_PROVIDER=console
MAIL_FROM=hallo@tri-hotel.de
# Antwortadresse für Anfragen an Hotels und Benachrichtigung bei eingehenden Antworten
MAIL_REPLY_TO=info@tri-hotel.de
ADMIN_NOTIFY_EMAIL=info@triprep.de
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Agenten senden mit eigener Adresse (own, braucht Aliase) oder über die Sammeladresse der Site (site)
MAIL_PERSONA_SENDER=site
# Empfang von Antworten: none | imap (IONOS: imap.ionos.de, 993); Zugang ohne Angabe wie SMTP
MAIL_INBOUND=none
# Weiteres Postfach nur lesen (z. B. daniel@): Antworten und Rückläufer zu unseren Mails übernehmen, private Post bleibt draußen
IMAP_EXTRA_USER=
IMAP_EXTRA_PASS=
IMAP_EXTRA_DAYS=14
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX
IMAP_DONE_FOLDER=Verarbeitet

# LLM-Extraktion (Anbieter noch offen) – 'none' überspringt die Extraktion, 'anthropic' nutzt Claude
LLM_PROVIDER=none
LLM_API_KEY=
# nur nötig, wenn der Schlüssel keinem Workspace zugeordnet ist (Claude Console › Settings › Workspaces)
LLM_WORKSPACE_ID=
# Modell je Aufgabe (Standard: claude-opus-5-5); günstiger z. B. claude-sonnet-5-5 – vorher mit npm run compare-models prüfen
LLM_MODEL_EXTRACT=
LLM_MODEL_INQUIRY=
# Beschreibungstexte je Objekt (Standard: claude-sonnet-5-5)
LLM_MODEL_DESCRIBE=
# Gegenprüfung der Beschreibungstexte (Standard: claude-haiku-5-5)
LLM_MODEL_DESCRIBE_CHECK=
# Website per Websuche finden (Standard: claude-sonnet-5-5)
LLM_MODEL_WEBSITE=
# Obergrenze der KI-Kosten je Kalendermonat in US-Dollar (leer = keine); danach werden Aufrufe übersprungen
LLM_MONTHLY_BUDGET_USD=
# Preise je 1 Mio. Tokens, falls sie von den Standardwerten in src/lib/llm.js abweichen
LLM_PRICES=

# Admin-Login mit Google (OAuth-Client vom Typ „Webanwendung“, Weiterleitungs-URI: <BASE_URL>/admin/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google-Bewertungen als Zwei-Klick-Karte (Maps Embed API, kostenlos). Schlüssel in der Google Cloud Console
# auf „Websites“ (tri-hotel.de/*, www.tri-hotel.de/*, localhost:3010/*) und auf die Maps Embed API beschränken. Leer = nur Link.
GOOGLE_MAPS_EMBED_KEY=
# Place-ID-Suche im Admin (Places API (New), nur serverseitig). Eigener Schlüssel, beschränkt auf die Server-IP
# und die Places API (New). Leer = Suche ausgeblendet, Place ID nur von Hand.
GOOGLE_PLACES_KEY=
# Hunter.io (Domain Search): Kontaktadresse, wenn Website und OpenStreetMap keine liefern. Nur allgemeine Adressen
# (info@, reservas@ …), immer als Vorschlag zur Bestätigung im Admin. Leer = aus. Grenze = Abfragen je Kalendermonat.
HUNTER_API_KEY=
HUNTER_MONTHLY_LIMIT=40
# Passwort-Login zusätzlich erlauben (Standard: nur, solange Google nicht eingerichtet ist)
ADMIN_PASSWORD_LOGIN=

# Vorab-Phase (vor dem Livegang): Login über SSH-Tunnel ohne HTTPS erlauben, Suchmaschinen aussperren
COOKIE_SECURE=false
NOINDEX=true

# Morgenbericht mit den Zahlen des Vortags: leer = aus. Nicht die abgerufene Adresse (info@), das gäbe eine Aufgabe im Admin.
DAILY_REPORT_TO=
# Uhrzeit als Cron-Ausdruck nach Berliner Zeit (Standard 7 Uhr)
DAILY_REPORT_CRON=0 7 * * *

# Besucherstatistik ohne Cookies (Plausible), leer = aus
PLAUSIBLE_SRC=
# Seitenaufrufe im Admin-Dashboard: API-Schlüssel aus Plausible (leer = Kachel zeigt nur einen Hinweis);
# API-Adresse nur nötig, wenn sie nicht der Herkunft von PLAUSIBLE_SRC entspricht
PLAUSIBLE_API_KEY=
PLAUSIBLE_API_URL=

# Bild-Uploads (außerhalb des Repos)
UPLOAD_DIR=uploads

# Interne API für den Hub danielreuland.com (docs/internal-api.md). Nur auf dem Server eintragen, nie im Repo:
# "hub:<geheimnis>" (mind. 32 Zeichen, z. B. openssl rand -hex 32); Schlüsselwechsel: "hub:<neu>,hub:<alt>". Leer = API lehnt alles ab.
INTERNAL_API_KEYS=
# Ereignisse an den Hub (Anfrage gesendet/beantwortet …), z. B. http://127.0.0.1:3020/internal/v1/events. Leer = nur protokollieren.
HUB_EVENTS_URL=
HUB_EVENTS_SECRET=

# Tripadvisor-Fotos über Terra (docs/tripadvisor-fotos-umsetzung.md). Not-Aus: nur "true" schaltet Abrufe frei;
# ohne diesen Wert geht kein Aufruf an Tripadvisor. Erst einschalten, wenn Tripadvisor die Darstellung bestätigt hat.
TA_PHOTOS_ENABLED=false
# Schlüssel nur auf dem Server eintragen (read -s), nie im Repo oder Chat
TRIPADVISOR_API_KEY=
# Grenzen in abrechenbaren Einheiten (Foto-Abruf = 1, Suche = 1 je zurückgegebener Location ID); 400/Monat ≈ 6 USD
TA_MONTHLY_LIMIT=400
TA_DAILY_LIMIT=20
# Freikontingent einmalig je Konto, danach Preis je Einheit in USD; Offset = außerhalb der App verbrauchte Einheiten
TA_FREE_UNITS=1000
TA_UNIT_PRICE_USD=0.015
TA_UNITS_OFFSET=0
# Höchstzahl der Objekte mit Tripadvisor-Fotos und Mindest-Score für die Suche nach Location IDs
TA_MAX_HOTELS=10
TA_MIN_SCORE=70
# Weitere Werte mit Standard (nur bei Bedarf setzen): TA_PHOTO_COUNT=5, TA_SEARCH_SIZE=3, TA_TIMEOUT_MS=3000,
# TA_VIEW_LOCK_MINUTES=30, TA_ALLOWLIST=true, TA_IMAGE_HOSTS=tripadvisor.com,tacdn.com, TA_PHOTO_PARAMS=,
# TA_LOCATION_URL=https://www.tripadvisor.de/Hotel_Review-d{id}, TA_PHOTOS_URL=https://www.tripadvisor.de/Hotel_Review-d{id}#/media
