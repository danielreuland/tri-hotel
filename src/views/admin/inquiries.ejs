<%- include('../partials/admin-head') %>
<h1>Anfragen</h1>
<p class="muted">Alle Anfragen an Betreiber: an welches Objekt, an welche Adresse, von welcher Persona, wer sie freigegeben hat und wie der Stand ist. Entwürfe legt die Auto-Prüfung für offene Punkte an – verschickt wird erst nach deiner Freigabe in der Prüfansicht.</p>
<% if (mailProvider === 'console') { %><div class="flash" style="border-color:var(--ok)"><strong>Mailversand noch nicht eingerichtet:</strong> freigegebene Anfragen werden formuliert und protokolliert, aber nicht zugestellt.</div><% } %>

<div class="pill-row">
  <% Object.keys(INQUIRY_FILTERS).forEach(function (k) { %>
    <a class="badge <%= k === status ? 'good' : '' %>" href="/admin/anfragen?status=<%= k %>"><%= INQUIRY_FILTERS[k].label %> (<%= counts[k] %>)</a>
  <% }) %>
</div>
<form method="get" class="filters">
  <input type="hidden" name="status" value="<%= status %>">
  <input type="search" name="q" value="<%= q %>" placeholder="Objekt oder E-Mail-Adresse" aria-label="Suchen">
  <button class="btn small secondary" type="submit">Suchen</button>
</form>

<% if (!rows.length) { %>
  <p class="card">Keine Anfragen in dieser Ansicht.</p>
<% } else { %>
  <div class="table-scroll">
    <table>
      <tr><th>Objekt</th><th>An</th><th>Fragen</th><th>Status</th><th>Verlauf</th><th></th></tr>
      <% rows.forEach(function (i) { var labels = i.criteria_labels || []; %>
        <tr>
          <td><a href="/admin/meldungen/<%= i.sub_id %>#anfragen"><strong><%= i.entity_name %></strong></a><br><small class="muted"><%= i.city || '' %></small><% if (i.opt_out_at) { %><br><span class="badge bad" title="<%= i.opt_out_note || '' %>">abgemeldet <%= formatDate(i.opt_out_at) %></span><% } %></td>
          <td><small><%= i.recipient %><br><%= i.persona_name ? 'von ' + i.persona_name + (i.persona_is_ai ? ' (KI)' : '') : '' %> · <%= i.language.toUpperCase() %></small></td>
          <td><% if (i.status === 'draft' && i.persona_is_ai === false) { %><small>Vollständige Prüfung + Fotos<br><span class="muted"><%= i.body ? 'Entwurf erstellt' : 'Entwurf noch nicht erstellt' %></span></small><% } else { %><small title="<%= labels.join(', ') %>"><%= labels.length %> Fragen<%= i.ask_photos ? ' + Fotos' : '' %><br><span class="muted"><%= labels.slice(0, 3).join(', ') %><%= labels.length > 3 ? ' …' : '' %></span></small><% } %></td>
          <td>
            <span class="badge <%= i.status === 'draft' ? 'warn' : i.status === 'answered' ? 'good' : i.status === 'failed' ? 'bad' : '' %>"><%= INQUIRY_STATUS[i.status] %></span>
            <% if (i.pending_answers) { %><br><small><a href="/admin/meldungen/<%= i.sub_id %>#anfragen"><%= i.pending_answers %> Antwort(en) übernehmen</a></small><% } %>
            <% if (i.error && (i.status !== 'closed' || /abmeld/i.test(i.error))) { %><br><small style="color:var(--bad)"><%= i.error %></small><% } %>
          </td>
          <%# Verlauf: je Ereignis eine Zeile, Datum vorn (in zeitlicher Reihenfolge der Schritte) %>
          <% var steps = [
               [i.created_at, i.auto_created ? 'Entwurf automatisch' : 'angelegt von ' + (i.created_by_email || 'Admin')],
               [i.approved_at, 'freigegeben' + (i.approved_by_email ? ' von ' + i.approved_by_email : '')],
               [i.sent_at, 'versendet'],
               [i.reminder_sent_at, 'erinnert'],
               [i.first_opened_at, 'Link geöffnet'],
               [i.answered_at, 'Antwort' + (i.reply_name ? ' von ' + i.reply_name : '')]
             ].filter(function (s) { return s[0]; }); %>
          <td><small class="muted" style="display:grid;grid-template-columns:auto 1fr;column-gap:10px">
            <% steps.forEach(function (s) { %><span style="white-space:nowrap;font-variant-numeric:tabular-nums"><%= formatDate(s[0]) %></span><span><%= s[1] %></span><% }) %>
          </small></td>
          <td style="white-space:nowrap"><% if (i.status === 'draft') { %><a class="btn small" href="/admin/meldungen/<%= i.sub_id %>#anfragen">Prüfen &amp; freigeben</a><% } %></td>
        </tr>
      <% }) %>
    </table>
  </div>
<% } %>

<%- include('../partials/admin-foot') %>
