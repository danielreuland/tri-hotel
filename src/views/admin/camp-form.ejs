<%- include('../partials/admin-head') %>
<% var f = p.features || {}; var tri = function (v) { return v === true ? 'yes' : v === false ? 'no' : ''; };
   var triSel = function (name, v) { return '<select name="' + name + '"><option value="">nicht erkennbar</option><option value="yes"' + (tri(v) === 'yes' ? ' selected' : '') + '>ja</option><option value="no"' + (tri(v) === 'no' ? ' selected' : '') + '>nein</option></select>'; }; %>
<p><a href="/admin/camps">← Camp-Anbieter</a><% if (p.id && p.status === 'active') { %> · <a href="/trainingscamp/anbieter/<%= p.slug %>" target="_blank">Öffentliche Seite ↗</a><% } %></p>
<h1><%= p.id ? p.name : 'Neuer Anbieter' %></h1>
<% if (flash) { %><div class="flash" style="border-color:var(--ok)"><%= flash %></div><% } %>
<% if (flashError) { %><div class="errors"><%= flashError %></div><% } %>
<% if (p.id) { %><%- include('_camp-check') %><% } %>
<% if (errors.length) { %><div class="errors"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div><% } %>
<form method="post" action="/admin/camps<%= p.id ? '/' + p.id : '' %>" class="card">
  <div class="form-row">
    <div><label>Name *</label><input name="name" type="text" required value="<%= p.name || '' %>"></div>
    <div><label>Slug</label><input name="slug" type="text" value="<%= p.slug || '' %>"></div>
    <div><label>Status</label><select name="status"><% var SL = { draft: 'in Prüfung', active: 'freigegeben', rejected: 'abgelehnt', archived: 'archiviert' }; ['draft', 'active', 'rejected', 'archived'].forEach(function (s) { %><option value="<%= s %>" <%= p.status === s ? 'selected' : '' %>><%= SL[s] %></option><% }) %></select></div>
  </div>
  <div class="form-row">
    <div><label>Typ</label><select name="model"><% Object.keys(MODELS).forEach(function (k) { %><option value="<%= k %>" <%= p.model === k ? 'selected' : '' %>><%= MODELS[k] %></option><% }) %></select></div>
    <div><label>Typ genauer</label><input name="model_label" type="text" value="<%= p.model_label || '' %>" placeholder="Coach (Ex-Profi)"></div>
    <div><label>Sitz</label><input name="seat" type="text" value="<%= p.seat || '' %>"></div>
  </div>
  <label>Kurzprofil <small class="muted">in eigenen Worten, keine Werbetexte übernehmen</small></label><textarea name="summary" rows="3"><%= p.summary || '' %></textarea>
  <% var words = profileWords(p); %><small class="muted"><%= words %> Wörter · <%= words >= minProfileWords ? 'Profil wird von Suchmaschinen indexiert' : 'ab ' + minProfileWords + ' Wörtern indexieren Suchmaschinen das Profil (bis dahin noindex, nicht in der Sitemap)' %></small>
  <div class="form-row">
    <div><label>Website *</label><input name="website" type="url" required value="<%= p.website || '' %>"></div>
  </div>
  <% var CSRC = { website: 'von der Website', hunter: 'über Hunter.io', admin: 'vom Admin eingetragen' }; var hsug = ((p.check_report || {}).hunter || {}).suggestion; %>
  <div class="form-row">
    <div><label for="cp-email">Kontakt-E-Mail <small class="muted">allgemein, nicht der Empfänger von Anfragen</small></label>
      <input id="cp-email" name="contact_email" type="email" value="<%= p.contact_email || '' %>" placeholder="info@anbieter.de">
      <small class="muted"><%= p.contact_source ? CSRC[p.contact_source] || p.contact_source : 'noch keine' %><% if (p.contact_evidence) { %> · <a href="<%= p.contact_evidence %>" target="_blank" rel="noopener">Fundstelle</a><% } %></small>
      <% if (hsug && hsug.email !== p.contact_email) { %><br><small>Vorschlag Hunter.io: <strong><%= hsug.email %></strong> (<%= hsug.confidence %> %) · <a href="<%= hsug.evidenceUrl %>" target="_blank" rel="noopener">Fundstelle</a></small>
        <button class="btn small secondary" type="submit" form="cp-hunter-accept">Übernehmen</button><% } %></div>
    <div><label for="cp-phone">Telefon</label><input id="cp-phone" name="contact_phone" type="text" maxlength="60" value="<%= p.contact_phone || '' %>"></div>
  </div>
  <div class="form-row">
    <div><label>Ziele <small class="muted">kommagetrennt</small></label><input name="destinations" type="text" value="<%= (p.destinations || []).join(', ') %>"></div>
    <div><label>Regionen (Filter) <small class="muted">kommagetrennt</small></label><input name="regions" type="text" value="<%= (p.regions || []).join(', ') %>" placeholder="Kanaren, Mallorca, Alpen"></div>
  </div>
  <h3>Abgleich für Sammelanfragen <small class="muted">leer = keine Einschränkung; sortiert wird nur nach Passung</small></h3>
  <% var MN = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez']; var mm = (p.match_months || []).map(Number); var ml = p.match_levels || []; %>
  <fieldset style="border:0;padding:0;margin:0"><legend>Monate mit Camps</legend>
    <div class="chip-row"><% MN.forEach(function (n, i) { %><label class="chip"><input type="checkbox" name="match_months" value="<%= i + 1 %>" <%= mm.indexOf(i + 1) >= 0 ? 'checked' : '' %>> <%= n %></label><% }) %></div></fieldset>
  <fieldset style="border:0;padding:0;margin:8px 0 0"><legend>Niveaus</legend>
    <div class="chip-row"><% [['beginner', 'Einsteiger'], ['intermediate', 'Fortgeschritten'], ['ambitious', 'Ambitioniert / Langdistanz']].forEach(function (l) { %><label class="chip"><input type="checkbox" name="match_levels" value="<%= l[0] %>" <%= ml.indexOf(l[0]) >= 0 ? 'checked' : '' %>> <%= l[1] %></label><% }) %></div></fieldset>
  <div class="form-row">
    <div><label>Gruppe min.</label><input name="group_min" type="number" min="1" value="<%= p.group_min || '' %>"></div>
    <div><label>Gruppe max.</label><input name="group_max" type="number" min="1" value="<%= p.group_max || '' %>"></div>
    <div><label>Eigene Vereins-/Gruppencamps</label><select name="exclusive_groups"><option value="">unbekannt</option><option value="yes" <%= p.exclusive_groups === true ? 'selected' : '' %>>ja</option><option value="no" <%= p.exclusive_groups === false ? 'selected' : '' %>>nein</option></select></div>
    <div><label>Preis je Person von – bis (€)</label><div style="display:flex;gap:6px"><input name="price_min" type="text" inputmode="numeric" value="<%= p.price_min || '' %>" style="width:90px"><input name="price_max" type="text" inputmode="numeric" value="<%= p.price_max || '' %>" style="width:90px"></div></div>
  </div>
  <h3>Leistungen</h3>
  <div class="form-row">
    <div><label>Hotel</label><select name="f_hotel"><% Object.keys(HOTEL_VALUES).forEach(function (k) { %><option value="<%= k %>" <%= (f.hotel || 'unknown') === k ? 'selected' : '' %>><%= HOTEL_VALUES[k] %></option><% }) %></select></div>
    <div><label>Hotel-Hinweis</label><input name="f_hotel_note" type="text" value="<%= f.hotel_note || '' %>"></div>
    <div><label>Flug</label><select name="f_flight"><% Object.keys(FLIGHT_VALUES).forEach(function (k) { %><option value="<%= k %>" <%= (f.flight || 'unknown') === k ? 'selected' : '' %>><%= FLIGHT_VALUES[k] %></option><% }) %></select></div>
    <div><label>Flug-Hinweis</label><input name="f_flight_note" type="text" value="<%= f.flight_note || '' %>"></div>
  </div>
  <div class="form-row">
    <div><label>Camp ohne Hotel</label><%- triSel('f_camp_only', f.camp_only) %></div>
    <div><label>Einsteiger</label><%- triSel('f_beginner', f.beginner) %></div>
    <div><label>Frauen-Camp</label><%- triSel('f_women', f.women) %></div>
    <div><label>Schwimm-Camp</label><%- triSel('f_swim', f.swim) %></div>
    <div><label>Familie / Kinder</label><%- triSel('f_family', f.family) %></div>
  </div>
  <div class="form-row">
    <div><label>Hinweis Familie</label><input name="f_family_note" type="text" value="<%= f.family_note || '' %>"></div>
    <div><label>Max. Gruppe</label><input name="f_max_group" type="text" value="<%= f.max_group || '' %>"></div>
  </div>
  <label>Preisbeispiele <small class="muted">eine Zeile je Beispiel: Bezeichnung | Dauer | Preis | enthalten | nicht enthalten</small></label>
  <textarea name="prices" rows="3"><%= pricesText %></textarea>
  <label for="hotel-entities">Hotels im Ranking <small class="muted">Mehrfachauswahl, Suche nach Name oder Ort</small></label>
  <select id="hotel-entities" name="hotel_entities" multiple data-combo data-placeholder="Hotel suchen …" size="8">
    <% entityOptions.forEach(function (o) { %>
      <option value="<%= o.id %>" data-search="<%= o.city || '' %> <%= o.country || '' %>" data-hint="<%= [o.city, o.country].filter(Boolean).join(', ') %><%= o.live ? '' : ' · nicht live' %>" <%= selectedIds.indexOf(o.id) >= 0 ? 'selected' : '' %>><%= o.name %><%= o.city ? ' (' + o.city + ')' : '' %></option>
    <% }) %>
  </select>
  <label for="hotels-free">Weitere Hotels (nicht im Ranking) <small class="muted">eine Zeile je Hotel: Name | Ort | Region – erscheinen auf dem Anbieterprofil ohne Link</small></label>
  <textarea id="hotels-free" name="hotels" rows="3"><%= hotelsText %></textarea>
  <% if (suggestions.length) { %>
    <div class="card" style="margin-top:8px;padding:10px 14px">
      <p style="margin:0 0 4px"><strong>Passende Hotels im Ranking gefunden</strong> <small class="muted">anhaken und speichern, um die Zeile zu verknüpfen – nichts wird automatisch verknüpft</small></p>
      <% suggestions.forEach(function (s) { %>
        <label class="inline" style="margin:2px 0"><input type="checkbox" name="adopt" value="<%= s.row.hotel_name %>::<%= s.hit.entity.id %>">
          <span>„<%= s.row.hotel_name %>“<%= s.row.place ? ' (' + s.row.place + ')' : '' %> → <strong><%= s.hit.entity.name %></strong><%= s.hit.entity.city ? ' (' + s.hit.entity.city + ')' : '' %>
            <small class="muted"><%= s.hit.exact ? 'gleicher Name' : 'ähnlicher Name' %></small></span></label>
      <% }) %>
    </div>
  <% } %>
  <div class="form-row">
    <div><label>Stand der Angaben</label><input name="as_of" type="date" value="<%= p.as_of ? new Date(p.as_of).toISOString().slice(0, 10) : '' %>"></div>
    <div><label>Quelle</label><input name="source_url" type="url" value="<%= p.source_url || '' %>"></div>
  </div>
  <h3>Partnerschaft</h3>
  <p class="muted" style="margin-top:0"><small>Nur mit Vereinbarung. Partner erscheinen mit „Anzeige · Partner“; Reihenfolge und Darstellung ändern sich nicht.</small></p>
  <div class="form-row">
    <div><label class="inline"><input type="checkbox" name="partner" <%= p.partner ? 'checked' : '' %>> Partner</label></div>
    <div><label>Partner-Link</label><input name="partner_url" type="url" value="<%= p.partner_url || '' %>"></div>
  </div>
  <h3>Anfragen (Leads)</h3>
  <p class="muted" style="margin-top:0"><small>Nur mit Vereinbarung. Dann erscheint auf dem Anbieterprofil das Formular „Unverbindlich anfragen“ und auf Hotelseiten „Camp hier anfragen“. Bestätigte Anfragen leitest du unter Kommunikation → Camp-Anfragen weiter; abgerechnet wird zu den Konditionen, die bei der Weitergabe gelten.</small></p>
  <div class="form-row">
    <div><label class="inline"><input type="checkbox" name="lead_active" <%= p.lead_active ? 'checked' : '' %>> Anfrageformular aktiv</label></div>
    <div><label>Empfänger der Anfragen</label><input name="lead_email" type="email" value="<%= p.lead_email || '' %>" placeholder="anfragen@anbieter.de"></div>
  </div>
  <div class="form-row">
    <div><label>Vergütung</label><select name="lead_model"><option value="">– wählen –</option>
      <% [['per_lead', 'je Anfrage (€)'], ['commission', 'Provision je Buchung (%)'], ['free', 'ohne Vergütung (Test)']].forEach(function (m) { %><option value="<%= m[0] %>" <%= p.lead_model === m[0] ? 'selected' : '' %>><%= m[1] %></option><% }) %></select></div>
    <div><label>€ je Anfrage</label><input name="lead_fee" type="text" inputmode="decimal" value="<%= p.lead_fee === null || p.lead_fee === undefined ? '' : p.lead_fee %>"></div>
    <div><label>Provision %</label><input name="lead_commission" type="text" inputmode="decimal" value="<%= p.lead_commission === null || p.lead_commission === undefined ? '' : p.lead_commission %>"></div>
  </div>
  <div class="form-row">
    <div><label>Vereinbart seit</label><input name="lead_since" type="date" value="<%= p.lead_since ? new Date(p.lead_since).toISOString().slice(0, 10) : '' %>"></div>
    <div><label>Notiz zur Vereinbarung</label><input name="lead_notes" type="text" value="<%= p.lead_notes || '' %>" placeholder="z. B. per Mail vom …, Rechnung quartalsweise"></div>
  </div>
  <p style="margin-bottom:0"><button class="btn" type="submit">Speichern</button></p>
</form>
<% if (p.id) { %><form id="cp-hunter-accept" method="post" action="/admin/camps/<%= p.id %>/kontakt-vorschlag"></form><% } %>
<%- include('../partials/admin-foot') %>
