<%- include('../partials/admin-head') %>
<p><a href="/admin/rankings">← Rankings</a></p>
<h1><%= ranking.name %> <% if (ranking.is_default) { %><span class="badge accent">Standard</span><% } %></h1>
<% if (errors.length) { %><div class="errors"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div><% } %>

<form method="post" class="card">
  <%- include('_ranking-fields') %>
  <p><button class="btn" type="submit">Speichern &amp; Scores neu berechnen</button></p>
</form>

<h2 id="kategorien">Kategorien</h2>
<div class="card">
  <% categories.forEach(function (cat) { var pts = criteria.filter(function (c) { return c.category_id === cat.id && c.active }).reduce(function (s, c) { return s + c.max_points }, 0); %>
    <form method="post" action="/admin/rankings/<%= ranking.id %>/kategorien/<%= cat.id %>" class="filters" style="margin:6px 0">
      <code style="width:110px"><%= cat.code %></code>
      <input name="label" type="text" value="<%= cat.label %>" style="flex:1;min-width:160px">
      <input name="sort_order" type="number" value="<%= cat.sort_order %>" style="width:90px" title="Reihenfolge">
      <span class="muted" style="width:80px"><%= pts %> Punkte</span>
      <button class="btn small secondary" type="submit">Speichern</button>
    </form>
  <% }) %>
  <form method="post" action="/admin/rankings/<%= ranking.id %>/kategorien" class="filters" style="margin:12px 0 0">
    <input name="code" type="text" placeholder="code" style="width:110px">
    <input name="label" type="text" placeholder="Neue Kategorie" style="flex:1;min-width:160px">
    <input name="sort_order" type="number" value="<%= categories.length + 1 %>" style="width:90px">
    <button class="btn small" type="submit">Hinzufügen</button>
  </form>
</div>

<h2 id="kriterien">Kriterien</h2>
<p>
  Summe aktiver Kriterien: <strong><%= pointsSum %> Punkte</strong>
  <% if (pointsSum !== 100) { %><span class="badge warn">weicht von 100 ab – unkritisch, der Score wird normiert</span><% } %>
</p>
<% if (warnings.length) { %><div class="errors"><strong>Hinweise:</strong><ul><% warnings.forEach(function (w) { %><li><%= w %></li><% }) %></ul></div><% } %>
<p>
  <a class="btn small" href="/admin/rankings/<%= ranking.id %>/kriterien/neu">Neues Kriterium</a>
  <form method="post" action="/admin/rankings/<%= ranking.id %>/neu-berechnen" style="display:inline"><button class="btn small secondary" type="submit">Alle Scores neu berechnen</button></form>
</p>
<div class="table-scroll">
<table>
  <tr><th>Kategorie</th><th>Kriterium</th><th>Typ</th><th class="num">max</th><th>K.O.</th><th class="num">Version</th><th>aktiv</th></tr>
  <% criteria.forEach(function (c) { %>
    <tr style="<%= c.active ? '' : 'opacity:.5' %>">
      <td><small><%= c.category_label %></small></td>
      <td><a href="/admin/rankings/<%= ranking.id %>/kriterien/<%= c.id %>"><%= c.label %></a><br><small class="muted"><%= c.code %></small></td>
      <td><small><%= VALUE_TYPES[c.value_type] %> · <%= c.scoring.type %><%= c.scoring.auto ? ' · auto' : '' %></small></td>
      <td class="num"><%= c.max_points %></td>
      <td><%= c.is_ko ? 'K.O.' : '' %></td>
      <td class="num"><%= c.version %></td>
      <td><%= c.active ? 'ja' : 'nein' %></td>
    </tr>
  <% }) %>
</table>
</div>
<%- include('../partials/admin-foot') %>
