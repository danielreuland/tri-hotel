<%- include('../partials/admin-head') %>
<%
  function valueString(c, fact) {
    if (!fact) return '';
    var v = fact.value || {};
    if (Array.isArray(v.options)) return v.options;
    if (v.option !== undefined) return v.option;
    if (v.bool !== undefined) return String(v.bool);
    if (v.number !== undefined) return String(v.number);
    return '';
  }
  var climateRow = climate.find(function (c) { return c.month === result.month }) || null;
%>

<p><a href="/admin/objekte">← <%= adminNav.objectsLabel %></a></p>
<h1><%= entity ? entity.name : sub.entity_name %></h1>
<% if (entity && entity.name !== sub.entity_name) { %><p class="muted" style="margin-top:-8px"><small>gemeldet als „<%= sub.entity_name %>“</small></p><% } %>
<p>
  <span class="badge accent"><%= STATUS_LABELS[sub.status] %></span>
  <span class="muted"><%= ranking.name %> · eingegangen <%= formatDate(sub.created_at) %><%= sub.created_by_admin ? ' · angelegt von ' + (sub.created_by_email || 'Admin') : '' %></span>
  <% if (entity && er && er.status === 'live') { %> · <a href="<%= ranking.is_default ? '/' + ranking.entity_type + '/' + entity.slug : '/rankings/' + ranking.slug + '/' + entity.slug %>" target="_blank">Öffentliche Seite ↗</a><% } %>
</p>

<% if (duplicateOf) { %>
  <div class="flash" style="border-color:var(--ok);background:var(--surface)">
    <strong><%= sub.status === 'duplicate' ? 'Als Dublette abgeschlossen:' : 'Mögliche Dublette von' %> <%= duplicateOf.name %></strong>
    <small class="muted">(<%= duplicateOf.city || '' %><%= duplicateOf.country ? ', ' + duplicateOf.country : '' %> · <%= duplicateOf.website || 'ohne Website' %>)</small><br>
    <small>Gleiche Website-Domain oder gleicher Name. Ketten und Reiseveranstalter betreiben oft mehrere Häuser unter einer Domain.</small>
    <form method="post" action="/admin/meldungen/<%= sub.id %>/dublette" class="filters" style="margin:10px 0 0">
      <% if (sub.status !== 'duplicate') { %><button class="btn small secondary" type="submit" name="decision" value="same">Dasselbe <%= ranking.entity_label_sg %> – zusammenführen</button><% } %>
      <button class="btn small" type="submit" name="decision" value="different">Eigenes <%= ranking.entity_label_sg %> – Prüfung fortsetzen</button>
    </form>
  </div>
<% } %>

<% if (entity) {
  var pendingAnswerCount = (inquiryList || []).reduce(function (n, i) { return n + (i.answers || []).concat(i.featureAnswers || []).filter(function (a) { return a.status === 'pending'; }).length; }, 0);
  var draftCount = (inquiryList || []).filter(function (i) { return i.status === 'draft'; }).length;
  var pendingImageCount = (images || []).filter(function (i) { return !i.approved_at; }).length + (text && text.status !== 'published' ? 1 : 0);
  var detailTabs = [
    { key: 'pruefung', label: 'Prüfung', anchor: 'pruefliste', n: review.open },
    { key: 'stammdaten', label: 'Stammdaten', anchor: 'stammdaten', n: 0 },
    { key: 'inhalte', label: 'Inhalte', anchor: 'text', n: pendingImageCount },
    { key: 'kommunikation', label: 'Kommunikation', anchor: 'anfragen', n: pendingAnswerCount + draftCount + (mailThread || []).filter(function (t) { return t.direction === 'in' && t.status === 'new'; }).length },
    { key: 'verlauf', label: 'Verlauf', anchor: 'meldung', n: 0 },
  ]; %>
  <nav class="detail-tabs" data-tabs aria-label="Bereiche dieser Seite">
    <% detailTabs.forEach(function (t) { %><a href="#<%= t.anchor %>" data-tab-link="<%= t.key %>"><%= t.label %><% if (t.n) { %> <span class="nav-count"><%= t.n %></span><% } %></a><% }) %>
  </nav>
<% } %>
<% if (entity) {
  var ba = entity.attributes || {}; var gsug = ba.geo_suggestion; var psug = ba.google_place_suggestion;
  var showBasics = sub.status === 'basics' || basicsMissing.length || gsug; %>
  <% if (showBasics) { %>
  <section class="card basics-card" id="grunddaten">
    <h2 style="margin:0 0 4px">Grunddaten <small class="muted"><%= sub.status === 'basics' ? '– die Auto-Prüfung wartet, bis alles vorliegt' : (basicsMissing.length ? '– unvollständig' : '– Koordinaten-Vorschlag offen') %></small></h2>
    <p class="muted" style="margin:0 0 10px"><small>Website, Google-Eintrag und Koordinaten müssen vorliegen, bevor Website-Auswertung, Klima, Umgebung und Score laufen. Ergänzt du hier etwas, geht es automatisch weiter – kein Neustart nötig.</small></p>
    <ul class="basics-list">
      <li class="<%= basicsMissing.indexOf('website') >= 0 ? 'todo' : 'done' %>">
        <strong>Website</strong>
        <% if (entity.website) { %><a href="<%= entity.website %>" target="_blank" rel="noopener"><%= entity.website %></a>
        <% } else if (ba.no_website) { %><span class="muted">keine Website (markiert)</span>
        <% } else { %><span>fehlt – in den <a href="#stammdaten">Stammdaten</a> eintragen</span><% } %>
        <% if (!entity.website) { %>
          <form method="post" action="/admin/meldungen/<%= sub.id %>/grunddaten/fehlt" class="inline-form"><input type="hidden" name="key" value="website"><input type="hidden" name="absent" value="<%= ba.no_website ? '0' : '1' %>"><button class="btn small secondary" type="submit"><%= ba.no_website ? 'Markierung aufheben' : 'Hat keine Website' %></button></form>
        <% } %>
      </li>
      <% if (placesEnabledForBasics) { %>
      <li class="<%= basicsMissing.indexOf('place') >= 0 ? 'todo' : 'done' %>">
        <strong>Google-Eintrag</strong>
        <% if (ba.google_place_id) { %><a href="<%= placesMapsLink(ba.google_place_id) %>" target="_blank" rel="noopener">in Google Maps ↗</a> <small class="muted"><%= ba.google_place_source && ba.google_place_source.via === 'auto' ? 'automatisch gefunden (eindeutig)' : 'vom Admin gesetzt' %></small>
        <% } else if (ba.no_google_place) { %><span class="muted">kein Google-Eintrag (markiert)</span>
        <% } else { %><span><%= psug && psug.status === 'unclear' ? psug.count + ' Treffer, keiner eindeutig' : psug && psug.status === 'none' ? 'kein Treffer bei Google' : 'noch nicht gesucht' %></span><% } %>
        <% if (!ba.google_place_id) { %>
          <form method="post" action="/admin/meldungen/<%= sub.id %>/google-suche" class="inline-form"><button class="btn small secondary" type="submit">Bei Google suchen</button></form>
          <form method="post" action="/admin/meldungen/<%= sub.id %>/grunddaten/fehlt" class="inline-form"><input type="hidden" name="key" value="place"><input type="hidden" name="absent" value="<%= ba.no_google_place ? '0' : '1' %>"><button class="btn small secondary" type="submit"><%= ba.no_google_place ? 'Markierung aufheben' : 'Kein Google-Eintrag' %></button></form>
        <% } %>
      </li>
      <% } %>
      <li class="<%= basicsMissing.indexOf('coords') >= 0 ? 'todo' : 'done' %>">
        <strong>Koordinaten</strong>
        <% if (entity.lat !== null) { %><span><%= Number(entity.lat).toFixed(5) %>, <%= Number(entity.lng).toFixed(5) %></span> <small class="muted"><%= ba.geo_source || '' %></small>
        <% } else { %><span>fehlen<%= gsug && gsug.reason ? ' – ' + gsug.reason : '' %></span><% } %>
      </li>
    </ul>

    <% if (entity.lat === null || gsug) { %>
      <div class="geo-pick">
        <div>
          <% if (gsug && gsug.candidates && gsug.candidates.length) { %>
            <p style="margin:0 0 6px"><strong>Vorschlag</strong> <small class="muted">(offene Quellen<%= gsug.google_distance_m !== null && gsug.google_distance_m !== undefined ? ', ' + gsug.google_distance_m.toLocaleString('de-DE') + ' m vom Google-Eintrag entfernt' : '' %>)</small></p>
            <% gsug.candidates.forEach(function (c, i) { %>
              <form method="post" action="/admin/meldungen/<%= sub.id %>/koordinaten" class="geo-candidate">
                <input type="hidden" name="lat" value="<%= c.lat %>"><input type="hidden" name="lng" value="<%= c.lng %>"><input type="hidden" name="how" value="vorschlag">
                <span class="geo-dot"><%= i + 1 %></span>
                <small><%= c.source %><br><span class="muted"><%= c.detail %></span></small>
                <button class="btn small" type="submit">Übernehmen</button>
              </form>
            <% }) %>
          <% } %>
          <div class="geo-map" data-geo-pick
               data-candidates="<%= JSON.stringify(((gsug && gsug.candidates) || []).map(function (c) { return [Number(c.lat), Number(c.lng)]; })) %>"
               data-current="<%= entity.lat !== null ? JSON.stringify([Number(entity.lat), Number(entity.lng)]) : '' %>"
               data-center="<%= gsug && gsug.center ? JSON.stringify([gsug.center.lat, gsug.center.lng]) : '' %>">
            <p class="muted" style="padding:12px">Karte wird geladen …</p>
          </div>
          <form method="post" action="/admin/meldungen/<%= sub.id %>/koordinaten" class="geo-click-form" data-geo-click>
            <input type="hidden" name="lat"><input type="hidden" name="lng"><input type="hidden" name="how" value="karte">
            <small class="muted" data-geo-hint>In die Karte klicken, um die genaue Lage zu setzen.</small>
            <button class="btn small" type="submit" disabled>Gesetzten Punkt übernehmen</button>
          </form>
        </div>
        <% if (googleMapsEnabled && (ba.google_place_id || entity.name)) { %>
          <div>
            <p style="margin:0 0 6px"><strong>Zum Vergleich: Google</strong> <small class="muted">nur Anzeige, wird nicht gespeichert</small></p>
            <iframe class="geo-google" src="<%= googleMapsEmbedUrl(entity) %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Google-Karte zum Vergleich"></iframe>
          </div>
        <% } %>
      </div>
    <% } %>
    <% if (sub.status === 'basics') { %>
      <form method="post" action="/admin/meldungen/<%= sub.id %>/pruefen" style="margin-top:10px">
        <button class="btn small secondary" type="submit">Grunddaten erneut suchen</button>
        <small class="muted">z. B. nach Änderung von Name, Ort oder Website</small>
      </form>
    <% } %>
  </section>
  <% } %>
<% } %>
<% if (entity) { %>
  <section class="card review-list" id="pruefliste" data-tab="pruefung">
    <% if (review.items.length) { %>
      <h2 style="margin:0 0 4px">Zu prüfen <small class="muted"><%= review.open ? review.open + ' offen' : 'nur Empfehlungen' %><%= review.blockers ? ' · ' + review.blockers + ' blockierend' : '' %></small></h2>
      <%- include('../partials/review-items', { items: review.items, entityId: entity.id, rankingId: ranking.id, linkBase: '', back: '/admin/meldungen/' + sub.id + '#pruefliste' }) %>
    <% } else { %>
      <strong>✓ Alles geprüft.</strong> <small class="muted">Keine offenen Punkte.</small>
    <% } %>
    <% if (review.dismissed) { %>
      <form method="post" action="/admin/pruefpunkte/zuruecksetzen" style="margin-top:8px">
        <input type="hidden" name="entity_id" value="<%= entity.id %>"><input type="hidden" name="ranking_id" value="<%= ranking.id %>">
        <input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#pruefliste">
        <small class="muted"><%= review.dismissed %> als erledigt ausgeblendet ·</small> <button class="linklike" type="submit"><small>wieder einblenden</small></button>
      </form>
    <% } %>
  </section>
<% } else if (review.items.length) { %>
  <section class="card review-list" id="pruefliste" data-tab="pruefung"><strong><%= review.items[0].text %></strong></section>
<% } %>

<div class="admin-detail">
  <div>
    <section class="card" id="meldung" data-tab="verlauf">
      <h2 style="margin-top:0">Meldung</h2>
      <div class="form-row">
        <div><strong>Ort:</strong> <%= sub.city %>, <%= sub.country %></div>
        <% if (campSource) { %><div><strong>Herkunft:</strong> automatisch angelegt aus der Prüfung von <a href="/admin/camps/<%= campSource.id %>"><%= campSource.name %></a> – nach Freigabe wird das <%= ranking.entity_label_sg %> dort verknüpft</div><% } %>
        <div style="overflow-wrap:anywhere"><strong>Website:</strong> <% if (sub.website) { %><a href="<%= sub.website %>" target="_blank" rel="noopener"><%= sub.website %></a><% } else { %><span class="badge warn">fehlt</span> <small class="muted">bitte in den Stammdaten eintragen</small><% } %></div>
        <div style="overflow-wrap:anywhere"><strong><%= sub.created_by_admin ? 'Angelegt von:' : 'Eingereicht von:' %></strong> <%= sub.created_by_admin ? (sub.created_by_email || 'Admin') + ' (Admin)' : (sub.submitter_email || '–') %> <%= sub.submitter_role ? '(' + sub.submitter_role + ')' : '' %></div>
        <div><strong>Bestätigt:</strong> <%= sub.verified_at ? formatDate(sub.verified_at) : 'nein' %></div>
      </div>
      <% var hintKeys = Object.keys(sub.hints || {}); if (hintKeys.length) { %>
        <h3>Angaben des Melders <small class="muted">(nur Hinweis, kein Faktenwert)</small></h3>
        <ul>
          <% hintKeys.forEach(function (k) { var c = criteriaByCode[k]; var v = sub.hints[k]; %>
            <li><%= c ? c.label : k %>: <strong><%= c ? (describeValue(c, c.scoring.type === 'bool' ? { bool: v === 'true' } : { option: v }) || v) : v %></strong></li>
          <% }) %>
        </ul>
      <% } %>
      <% if (sub.notes) { %><p><strong>Hinweise:</strong> <%= sub.notes %></p><% } %>
      <% if (heldReview) { var hr = heldReview; var dims = (ranking.review_config && ranking.review_config.dimensions) || []; %>
        <div class="flash" style="margin:10px 0">
          <strong>Bewertung des Melders</strong> <small class="muted">· <%= hr.author_name %> · Aufenthalt <%= new Date(hr.stay_month).toLocaleDateString('de-DE', { month: 'long', year: 'numeric' }) %> · <%= hr.verified_at || hr.verified_by ? 'E-Mail bestätigt' : 'E-Mail noch unbestätigt' %> · <%= hr.images.length %> Foto(s)</small><br>
          <% dims.forEach(function (d) { var v = (hr.ratings || {})[d.code]; if (v) { %><span class="badge"><%= d.label %>: <%= v %>★</span> <% } }) %>
          <% if (hr.title) { %><br><strong><%= hr.title %></strong><% } %>
          <p style="white-space:pre-line;margin:6px 0"><%= hr.body %></p>
          <small class="muted">Geht mit der Freigabe des <%= ranking.entity_label_sg %>s (oder beim Zusammenführen mit einer Dublette) in die Moderation unter Kommunikation → Bewertungen. Bei Ablehnung wird sie gelöscht.</small>
        </div>
      <% } %>
      <% if (sub.admin_note) { %><p><strong>📝 Notiz:</strong> <%= sub.admin_note %></p><% } %>
      <% if (sub.rejection_reason) { %><p><strong>Ablehnungsgrund:</strong> <%= sub.rejection_reason %></p><% } %>
      <details <%= sub.status === 'auto_check' || sub.status === 'basics' ? 'open' : '' %>>
        <summary>Auto-Prüfung (<%= sub.pipeline_log.length %> Schritte)</summary>
        <ul class="log-list">
          <% sub.pipeline_log.forEach(function (l) { %>
            <li><span class="badge <%= l.ok ? 'good' : 'bad' %>"><%= l.ok ? 'ok' : 'Fehler' %></span> <strong><%= l.step %></strong> <small class="muted"><%= new Date(l.at).toLocaleString('de-DE') %></small><br><%= l.info || '' %></li>
          <% }) %>
        </ul>
      </details>
    </section>

    <% if (!entity) { %>
      <div class="card" style="margin-top:16px"><p>Noch kein Objekt angelegt – die Auto-Prüfung ist noch nicht gelaufen.</p></div>
    <% } else { %>

    <section class="card" style="margin-top:16px" id="stammdaten" data-tab="stammdaten">
      <h2 style="margin-top:0">Stammdaten</h2>
      <form method="post" action="/admin/meldungen/<%= sub.id %>/objekt">
        <div class="form-row">
          <div><label>Name</label><input name="name" type="text" value="<%= entity.name %>"></div>
          <div><label>Ort</label><input name="city" type="text" value="<%= entity.city || '' %>"></div>
          <div><label>Land</label><input name="country" type="text" maxlength="2" value="<%= entity.country || '' %>"></div>
        </div>
        <div class="form-row">
          <div><label>Website</label><input name="website" type="url" value="<%= entity.website || '' %>"></div>
          <div><label>Breitengrad</label><input name="lat" type="text" value="<%= entity.lat || '' %>"></div>
          <div><label>Längengrad</label><input name="lng" type="text" value="<%= entity.lng || '' %>"></div>
        </div>
        <div class="form-row">
          <div>
            <label>Kontakt-E-Mail des Betreibers</label>
            <input name="contact_email" type="email" value="<%= entity.contact_email || '' %>" placeholder="für Anfragen und Freigaben">
            <% var CSRC = { website: 'von der Website', osm: 'aus OpenStreetMap', hunter: 'über Hunter.io (allgemeine Adresse)' };
               var csug = (entity.attributes || {}).contact_suggestion; var clook = (entity.attributes || {}).contact_lookup; %>
            <small class="muted"><% if (!entity.contact_email) { %><span style="color:var(--ok)">fehlt – nötig für Anfragen an das <%= ranking.entity_label_sg %></span><% } else if (CSRC[entity.contact_email_source]) { %>automatisch gefunden <%= CSRC[entity.contact_email_source] %><% if (entity.contact_email_evidence) { %> · <a href="<%= entity.contact_email_evidence %>" target="_blank" rel="noopener">Fundstelle</a><% } %><%= entity.contact_email_source === 'hunter' ? ' – vom Admin bestätigt' : ' – bitte prüfen' %><% } else { %>vom Admin eingetragen<% } %></small>
            <% if (csug) { %>
              <div class="card" style="margin-top:6px;padding:8px 12px">
                <small><strong>Vorschlag von Hunter.io:</strong> <%= csug.email %> <span class="muted">(Trefferwahrscheinlichkeit <%= csug.confidence %> %<%= csug.stillOnPage ? '' : ', Seite evtl. veraltet' %>)</span>
                  · <a href="<%= csug.evidenceUrl %>" target="_blank" rel="noopener">Fundstelle ↗</a></small><br>
                <button class="btn small" type="submit" form="contact-accept">Übernehmen</button>
                <button class="btn small secondary" type="submit" form="contact-dismiss">Verwerfen</button>
              </div>
            <% } else if (!entity.contact_email) { %>
              <div style="margin-top:6px">
                <button class="btn small secondary" type="submit" form="contact-search" <%= hunterInfo.enabled && !hunterInfo.left ? 'disabled' : '' %>>Kontaktadresse suchen</button>
                <small class="muted">OpenStreetMap<%= hunterInfo.enabled ? ', dann Hunter.io (' + hunterInfo.left + ' von ' + hunterInfo.limit + ' Abfragen diesen Monat frei)' : '' %><%= clook && clook.hunter_at ? ' · zuletzt gesucht ' + formatDate(clook.hunter_at) + (clook.reason ? ': ' + clook.reason : '') : '' %></small>
              </div>
            <% } %>
          </div>
        </div>
        <div class="form-row">
          <div><label>Google Place ID <small class="muted">optional – macht den Link „Bewertungen bei Google“ exakt</small></label>
            <input name="google_place_id" type="text" value="<%= (entity.attributes || {}).google_place_id || '' %>" placeholder="ChIJ…">
            <small class="muted"><% if (placesEnabled) { %>Suche bei Google unten<% } else { %><a href="https://developers.google.com/maps/documentation/places/web-service/place-id#find-id" target="_blank" rel="noopener">Place ID finden ↗</a><% } %> · ohne ID sucht der Link nach Name und Anschrift · <a href="<%= googleMapsUrl(entity) %>" target="_blank" rel="noopener">Link testen ↗</a></small></div>
        </div>
        <p><button class="btn small" type="submit">Stammdaten speichern</button> <small class="muted">Slug: <%= entity.slug %></small></p>
      </form>
      <form id="contact-search" method="post" action="/admin/meldungen/<%= sub.id %>/kontakt-suche" data-busy="Suche läuft …"></form>
      <form id="contact-accept" method="post" action="/admin/meldungen/<%= sub.id %>/kontakt-vorschlag/uebernehmen"></form>
      <form id="contact-dismiss" method="post" action="/admin/meldungen/<%= sub.id %>/kontakt-vorschlag/verwerfen"></form>
      <% var ea = entity.attributes || {}; var sug = ea.google_place_suggestion; %>
      <% if (sug && sug.status === 'found' && !ea.google_place_id) { %>
        <div class="flash" style="margin-top:12px">
          <strong>Vorschlag für die Google Place ID</strong> (automatisch gesucht <%= new Date(sug.searched_at).toLocaleDateString('de-DE') %>):
          <code><%= sug.id %></code> · <%= sug.distance_m %> m von unseren Koordinaten · Name <%= sug.match === 2 ? 'stimmt überein' : 'passt teilweise' %>
          · <a href="<%= placesMapsLink(sug.id) %>" target="_blank" rel="noopener">in Google Maps prüfen ↗</a>
          <div class="filters" style="margin:8px 0 0">
            <form method="post" action="/admin/meldungen/<%= sub.id %>/google-place"><input type="hidden" name="place_id" value="<%= sug.id %>"><button class="btn small" type="submit">Übernehmen</button></form>
            <form method="post" action="/admin/meldungen/<%= sub.id %>/google-verwerfen"><button class="btn small secondary" type="submit">Verwerfen</button></form>
          </div>
        </div>
      <% } %>
      <% if (placesEnabled) { %>
        <form method="post" action="/admin/meldungen/<%= sub.id %>/google-suche" style="margin-top:12px">
          <button class="btn small secondary" type="submit">Place ID bei Google suchen</button>
          <small class="muted">sucht nach Name und Anschrift in der Nähe unserer Koordinaten<% if (sug && sug.status === 'unclear') { %> · automatische Suche war nicht eindeutig<% } else if (sug && sug.status === 'none') { %> · automatische Suche ohne Treffer<% } %></small>
        </form>
      <% } %>
      <% if (placeSearch) { %>
        <div class="card" style="margin-top:12px">
          <p style="margin-top:0"><strong>Treffer bei Google</strong> <small class="muted">für „<%= placeSearch.query %>“ – Angaben von Google, werden nicht gespeichert</small></p>
          <% if (!placeSearch.candidates.length) { %><p class="muted">Keine Treffer. Name oder Anschrift in den Stammdaten anpassen und erneut suchen.</p><% } %>
          <div class="table-scroll"><table>
            <% placeSearch.candidates.forEach(function (c) { %>
              <tr>
                <td><strong><%= c.name %></strong><% if (c.id === placeSearch.pick) { %> <span class="badge good">passt eindeutig</span><% } %><br><small class="muted"><%= c.address %></small></td>
                <td><small><%= c.distanceM === null ? 'Entfernung unbekannt' : c.distanceM.toLocaleString('de-DE') + ' m entfernt' %><br><%= ['Name passt nicht', 'Name passt teilweise', 'Name stimmt überein'][c.match] %></small></td>
                <td><a href="<%= placesMapsLink(c.id) %>" target="_blank" rel="noopener"><small>Maps ↗</small></a></td>
                <td><% if (c.id === ea.google_place_id) { %><span class="badge good">gesetzt</span><% } else { %><form method="post" action="/admin/meldungen/<%= sub.id %>/google-place"><input type="hidden" name="place_id" value="<%= c.id %>"><button class="btn small" type="submit">Übernehmen</button></form><% } %></td>
              </tr>
            <% }) %>
          </table></div>
        </div>
      <% } %>
    </section>

    <section class="card" style="margin-top:16px" id="rankings" data-tab="stammdaten">
      <h2 style="margin-top:0">Rankings</h2>
      <p class="muted" style="margin-top:0"><small>In welchen Rankings dieses <%= ranking.entity_label_sg %> geprüft wird. „Prüfen“ startet eine eigene Prüfung für das Ranking (fehlende Werte, Prüfliste, Freigabe je Ranking); geteilte Werte wie Sauna oder Flughafen sind schon da.</small></p>
      <% var LISTING = { draft: 'in Vorbereitung', in_review: 'in Prüfung', live: 'live', rejected: 'nicht im Ranking' }; %>
      <div class="table-scroll"><table>
        <tr><th>Ranking</th><th>Stand</th><th class="num">Score</th><th></th></tr>
        <% memberships.forEach(function (m) { var inRanking = m.status && m.status !== 'rejected'; var current = m.id === ranking.id; %>
          <tr>
            <td><%= m.name %><% if (m.ranking_status === 'draft') { %> <span class="badge">Entwurf</span><% } %><% if (current) { %> <small class="muted">· diese Prüfung</small><% } %></td>
            <td><% if (inRanking) { %><span class="badge <%= m.status === 'live' ? 'good' : 'warn' %>"><%= LISTING[m.status] %></span><% } else { %><span class="muted"><%= m.status === 'rejected' ? 'entfernt' : '–' %></span><% } %></td>
            <td class="num"><%= inRanking && m.score !== null ? m.score : '–' %><% if (inRanking && m.completeness !== null) { %><br><small class="muted"><%= Math.round(m.completeness) %> %</small><% } %></td>
            <td style="white-space:nowrap">
              <% if (inRanking && m.sub_id && !current) { %><a class="btn small secondary" href="/admin/meldungen/<%= m.sub_id %>">öffnen</a><% } %>
              <% if (!inRanking) { %>
                <form method="post" action="/admin/objekte/<%= entity.id %>/rankings/<%= m.id %>/pruefen" style="display:inline"><input type="hidden" name="back" value="<%= sub.id %>"><button class="btn small" type="submit">Prüfen</button></form>
              <% } else { %>
                <form method="post" action="/admin/objekte/<%= entity.id %>/rankings/<%= m.id %>/entfernen" style="display:inline" data-confirm="<%= entity.name %> aus „<%= m.name %>“ nehmen?<%= m.status === 'live' ? ' Das Hotel ist dort live und wird offline genommen.' : '' %> Werte und andere Rankings bleiben erhalten."><input type="hidden" name="back" value="<%= sub.id %>"><button class="btn small secondary" type="submit">Entfernen</button></form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </table></div>
    </section>

    <section class="card" style="margin-top:16px" id="camp-anbieter" data-tab="stammdaten">
      <h2 style="margin-top:0">Camp-Anbieter in diesem <%= ranking.entity_label_sg %></h2>
      <p class="muted" style="margin-top:0"><small>Anbieter, die hier Trainingscamps durchführen. Erscheinen auf der Profilseite und beim Anbieter, ohne Einfluss auf Score oder Reihenfolge (<a href="/admin/camps">alle Camp-Anbieter</a>).</small></p>
      <% if (campProviderOptions.length) { %>
        <form method="post" action="/admin/meldungen/<%= sub.id %>/camp-anbieter">
          <label for="camp-providers" style="margin-top:0">Camp-Anbieter</label>
          <select id="camp-providers" name="providers" multiple data-combo data-placeholder="Anbieter suchen …" size="6">
            <% campProviderOptions.forEach(function (p) { %>
              <option value="<%= p.id %>" data-search="<%= p.seat || '' %>" data-hint="<%= [p.seat, p.status === 'active' ? '' : 'Entwurf'].filter(Boolean).join(' · ') %>" <%= campSelectedIds.indexOf(p.id) >= 0 ? 'selected' : '' %>><%= p.name %></option>
            <% }) %>
          </select>
          <p style="margin:10px 0 0"><button class="btn small" type="submit">Camp-Anbieter speichern</button></p>
        </form>
      <% } else { %><p class="muted" style="margin:0">Noch keine Camp-Anbieter angelegt.</p><% } %>
    </section>

    <section class="card" style="margin-top:16px" id="partnerlinks" data-tab="stammdaten">
      <h2 style="margin-top:0">Partnerlinks <small class="muted" style="font-weight:400">zum Bearbeiten aufklappen</small></h2>
      <p class="muted" style="margin-top:0"><small>Links zur Seite dieses <%= ranking.entity_label_sg %>s beim jeweiligen Anbieter. Erscheinen auf der Profilseite im Kasten „Buchen &amp; Anfragen“ als Anzeige – in der Reihenfolge aus den Partnerprogrammen, ohne Einfluss auf Score oder Reihenfolge der Hotels. Die Partnerkennung wird automatisch ergänzt (<a href="/admin/partner">Partnerprogramme</a>).</small></p>
      <form method="post" action="/admin/meldungen/<%= sub.id %>/partnerlinks">
        <% partnerPrograms.forEach(function (p) { var get = function (kind) { var l = partnerLinks.find(function (x) { return x.program_id === p.id && x.kind === kind; }); return l ? l.url : ''; }; %>
          <%
            // Stand je Anbieter für die eingeklappte Zeile
            var srcProg = p.id_from && partnerPrograms.find(function (x) { return x.code === p.id_from; });
            var srcLink = srcProg && partnerLinks.find(function (x) { return x.program_id === srcProg.id && x.kind === 'booking'; });
            var state = get('booking') ? ['good', 'Link eingetragen']
              : srcLink ? ['good', 'Nummer von ' + srcProg.name]
              : partnerAbsent.indexOf(p.id) >= 0 ? ['', 'nicht vorhanden']
              : p.status !== 'active' ? ['', 'inaktiv – wird nicht angezeigt']
              : ['warn', 'fehlt'];
          %>
          <details class="link-prog">
            <summary><strong><%= p.name %></strong> <span class="badge <%= state[0] %>"><%= state[1] %></span><% if (get('reviews')) { %> <span class="badge">Bewertungen</span><% } %>
              <% if (p.domains.length) { %><small class="muted">nur <%= p.domains.join(', ') %></small><% } %></summary>
            <div class="form-row">
              <div><label>Seite mit Preisen / Buchung<% if (p.id_url) { %> <small class="muted">– Adresse oder nur die Nummer</small><% } %></label><input name="links[<%= p.id %>][booking]" type="<%= p.id_url ? 'text' : 'url' %>" placeholder="<%= p.id_url ? 'https://… oder z. B. 793891' : 'https://' %>" value="<%= get('booking') %>"></div>
              <div><label>Bewertungsseite <small class="muted">optional</small></label><input name="links[<%= p.id %>][reviews]" type="url" placeholder="https://" value="<%= get('reviews') %>"></div>
            </div>
            <% if (p.id_from && !get('booking')) { var srcP = partnerPrograms.find(function (x) { return x.code === p.id_from; }); var srcL = srcP && partnerLinks.find(function (x) { return x.program_id === srcP.id && x.kind === 'booking'; }); %>
              <p style="margin:4px 0"><small class="muted"><%= srcL ? 'Ohne eigenen Link wird die Nummer aus dem ' + srcP.name + '-Link übernommen.' : 'Übernimmt die Nummer von ' + (srcP ? srcP.name : p.id_from) + ' – dort ist noch kein Link eingetragen.' %></small></p>
            <% } %>
            <% if (!get('booking')) { %><label class="inline" style="margin:4px 0"><input type="checkbox" name="links[<%= p.id %>][absent]" <%= partnerAbsent.indexOf(p.id) >= 0 ? 'checked' : '' %>> <span><small>Bei <%= p.name %> nicht vorhanden – nicht mehr nachfragen</small></span></label><% } %>
            <% if (p.search_url) { %><small><a href="<%= p.search_url.replace('{q}', encodeURIComponent(entity.name + ' ' + (entity.city || ''))) %>" target="_blank" rel="noopener"><%= /google\./.test(p.search_url) ? p.name + '-Seite des Hotels suchen ↗' : 'Bei ' + p.name + ' suchen ↗' %></a></small><% } %>
          </details>
        <% }) %>
        <button class="btn small" type="submit">Partnerlinks speichern</button>
      </form>
    </section>

    <section class="card" style="margin-top:16px" id="klima" data-tab="stammdaten">
      <h2 style="margin-top:0">Klima je Monat</h2>
      <% if (!climate.length) { %>
        <p class="muted">Keine Klimadaten. Sie kommen aus den Koordinaten (Open-Meteo, Mittel mehrerer Jahre) – Koordinaten prüfen und die Auto-Prüfung erneut starten bzw. „Daten aktualisieren“.</p>
      <% } else { var bt = (ranking.formula || {}).best_time || {}; %>
        <p class="muted" style="margin-top:0"><small>Nur Information, zählt nicht im <%= ranking.score_name %>. Hervorgehoben: beste Reisezeit<%= bt.metric ? ' (' + (bt.metric === 'avg_high_c' ? 'Tageshöchstwert' : bt.metric) + (bt.min !== undefined ? ' ab ' + bt.min : '') + (bt.max !== undefined ? ' bis ' + bt.max : '') + ' °C)' : '' %>.</small></p>
        <div class="table-scroll"><table>
          <tr><th>Monat</th><% climate.forEach(function (c) { %><th style="<%= bestMonths.includes(Number(c.month)) ? 'color:var(--good)' : '' %>"><%= MONTHS[c.month - 1].slice(0, 3) %></th><% }) %></tr>
          <tr><td>Max. °C</td><% climate.forEach(function (c) { %><td><%= c.avg_high_c === null ? '–' : Math.round(c.avg_high_c) %></td><% }) %></tr>
          <tr><td>Min. °C</td><% climate.forEach(function (c) { %><td><%= c.avg_low_c === null ? '–' : Math.round(c.avg_low_c) %></td><% }) %></tr>
          <tr><td>Regentage</td><% climate.forEach(function (c) { %><td><%= c.rain_days === null ? '–' : Math.round(c.rain_days) %></td><% }) %></tr>
        </table></div>
      <% } %>
    </section>

    <section class="card" style="margin-top:16px" id="fakten" data-tab="pruefung">
      <h2 style="margin-top:0">Fakten</h2>
      <p class="muted">Werte ohne Fundstelle bitte nicht übernehmen. Stimmt ein Vorschlag, genügt „✓ Übernehmen“ (sofort gespeichert). Änderst du einen Wert, springt die Vertrauensstufe auf 2 (Admin geprüft) – dann „Fakten speichern“.</p>
      <% var autoWithEvidence = facts.filter(function (f) { return f.trust_level === 4 && f.evidence_url && !f.disputed }).length; %>
      <div class="filters fact-tools">
        <label class="inline" style="margin:0"><input type="checkbox" id="only-open"> Nur offene Punkte zeigen</label>
        <span class="legend"><span class="badge warn">Vorschlag</span> automatisch, bitte prüfen · <span class="badge">fehlt</span> unbekannt · <span class="badge bad">strittig</span></span>
        <% if (autoWithEvidence) { %>
          <form method="post" action="/admin/meldungen/<%= sub.id %>/vorschlaege-bestaetigen" data-confirm="Alle <%= autoWithEvidence %> Vorschläge mit Fundstelle als „Admin geprüft“ übernehmen? Vorher bitte Fundstellen ansehen.">
            <button class="btn small secondary" type="submit"><%= autoWithEvidence %> Vorschläge mit Fundstelle übernehmen</button>
          </form>
        <% } %>
      </div>
      <form method="post" action="/admin/meldungen/<%= sub.id %>/fakten" id="facts-form" data-submission="<%= sub.id %>">
        <div class="table-scroll">
        <table>
          <% categories.forEach(function (cat) { %>
            <tr><th colspan="5"><h3 style="margin:.4em 0"><%= cat.label %></h3></th></tr>
            <% criteria.filter(function (c) { return c.category_id === cat.id }).forEach(function (c) {
                 var f = factByCrit[c.id]; var d = detailByCrit[c.id]; var s = c.scoring; var name = 'facts[' + c.id + ']'; var cur = valueString(c, f); %>
              <% var state = s.type === 'bonus' ? (d && d.known ? 'ok' : 'missing') : s.type === 'climate' ? (climateRow ? 'ok' : 'missing') : !f ? 'missing' : f.disputed ? 'disputed' : f.trust_level === 4 ? 'auto' : 'ok'; %>
              <tr class="crit-row state-<%= state %> <%= d && d.ko ? 'ko' : '' %>" data-crit="<%= c.id %>">
                <td style="min-width:200px"><%= c.label %><% if (c.is_ko) { %> <span class="badge bad">K.O.</span><% } %>
                  <% if (state === 'auto') { %> <span class="badge warn" data-state-badge>Vorschlag</span> <button type="button" class="btn small" data-accept-fact title="Wert unverändert als „Admin geprüft“ übernehmen – wird sofort gespeichert">✓ Übernehmen</button><% } else if (state === 'missing') { %> <span class="badge">fehlt</span><% } else if (state === 'disputed') { %> <span class="badge bad">strittig</span><% } %>
                  <br><small class="muted"><%= c.code %> · max <%= c.max_points %></small>
                  <% var ginfo = ((entity && entity.attributes) || {}).geo_info || {}; if (ginfo[c.code]) { %><br><small class="muted">ℹ <%= ginfo[c.code].text %></small><% } %>
                  <% if (c.link_source === 'camp_providers') { %><br><small><%= campLinks.length ? 'Camp-Anbieter hier: ' + campLinks.map(function (p) { return p.name; }).join(', ') : 'keine Camp-Anbieter verknüpft' %> · <a href="#camp-anbieter">verwalten</a></small><% } %>
                  <% if (state === 'auto' && f.evidence_text) { %><br><small class="evidence">„<%= f.evidence_text.slice(0, 160) %><%= f.evidence_text.length > 160 ? '…' : '' %>“<% if (f.evidence_url) { %> <a href="<%= f.evidence_url %>" target="_blank" rel="noopener">Quelle ↗</a><% } %></small><% } %>
                </td>
                <td style="min-width:190px">
                  <% if (s.type === 'bonus') { %>
                    <small class="muted">automatisch: +<%= s.points %>, wenn vorhanden: <%= [].concat(s.requires || []).map(function (code) { var x = criteria.find(function (k) { return k.code === code }); return x ? x.label : code; }).join(', ') %></small>
                  <% } else if (s.type === 'climate') { %>
                    <%= describeValue(c, null, climateRow) || 'keine Klimadaten' %><br><small class="muted"><%= result.month ? 'bester Monat: ' + MONTHS[result.month - 1] : '' %></small>
                  <% } else if (s.type === 'option' && s.multi) { var curList = [].concat(cur || []); %>
                    <div class="multi-opts" data-multi>
                      <% Object.keys(s.points).forEach(function (k) { %><label class="inline" style="display:block;margin:0"><input type="checkbox" name="<%= name %>[value][]" value="<%= k %>" data-value <%= curList.indexOf(k) >= 0 ? 'checked' : '' %>> <%= (s.labels && s.labels[k]) || k %> (<%= s.points[k] %>)</label><% }) %>
                      <small class="muted">mehrere möglich – es zählt die beste Angabe; nichts angehakt = unbekannt</small>
                    </div>
                  <% } else if (s.type === 'option') { %>
                    <select name="<%= name %>[value]" data-value>
                      <option value="">unbekannt</option>
                      <% Object.keys(s.points).forEach(function (k) { %><option value="<%= k %>" <%= cur === k ? 'selected' : '' %>><%= (s.labels && s.labels[k]) || k %> (<%= s.points[k] %>)</option><% }) %>
                    </select>
                  <% } else if (s.type === 'bool') { %>
                    <select name="<%= name %>[value]" data-value>
                      <option value="">unbekannt</option>
                      <option value="true" <%= cur === 'true' ? 'selected' : '' %>>ja (<%= s.points_true %>)</option>
                      <option value="false" <%= cur === 'false' ? 'selected' : '' %>>nein (<%= s.points_false || 0 %>)</option>
                    </select>
                  <% } else { %>
                    <input name="<%= name %>[value]" type="number" step="any" <%= s.type === 'rating' ? 'min=' + s.min + ' max=' + s.max : '' %> value="<%= cur %>" placeholder="unbekannt" data-value>
                  <% } %>
                </td>
                <td class="pts num"><span data-pts><%= d && d.known ? d.points : '–' %></span></td>
                <td style="min-width:240px">
                  <% if (s.type !== 'climate' && s.type !== 'bonus') { %>
                    <select name="<%= name %>[trust]" data-trust>
                      <% Object.keys(TRUST_LABELS).forEach(function (t) { %><option value="<%= t %>" <%= (f ? f.trust_level : 2) == t ? 'selected' : '' %>><%= TRUST_LABELS[t] %></option><% }) %>
                    </select>
                    <input name="<%= name %>[evidence_url]" type="url" placeholder="Fundstelle (URL)" value="<%= f ? f.evidence_url || '' : '' %>" style="margin-top:4px">
                    <details style="margin-top:4px"><summary><small>Textausschnitt<%= f && f.evidence_text ? ' ✓' : '' %></small></summary>
                      <textarea name="<%= name %>[evidence_text]" style="min-height:60px"><%= f ? f.evidence_text || '' : '' %></textarea>
                    </details>
                  <% } else { %><small class="muted"><%= s.type === 'bonus' ? 'berechnet' : 'Open-Meteo' %></small><% } %>
                </td>
                <td>
                  <% if (s.type !== 'climate' && s.type !== 'bonus') { %>
                    <label class="inline" style="margin:0"><input type="checkbox" name="<%= name %>[disputed]" <%= f && f.disputed ? 'checked' : '' %>><small>strittig</small></label>
                    <% if (f) { %><small class="muted"><%= formatDate(f.checked_at) %></small><% } %>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          <% }) %>
        </table>
        </div>
        <p><button class="btn" type="submit">Fakten speichern</button></p>
      </form>
    </section>

    <section class="card" style="margin-top:16px" id="leistungen" data-tab="pruefung">
      <h2 style="margin-top:0">Leistungen</h2>
      <p class="muted" style="margin-top:0">Einheitliche Namen aus dem <a href="/admin/leistungen">Leistungskatalog</a>. Abgeleitete Leistungen ergeben sich aus den Fakten oben; die übrigen hier anhaken.</p>
      <form method="post" action="/admin/meldungen/<%= sub.id %>/leistungen">
        <% var groupsSeen = []; featureCatalog.forEach(function (f) { if (groupsSeen.indexOf(f.group_label) < 0) groupsSeen.push(f.group_label) }); %>
        <div class="grid grid-3" style="gap:10px 18px">
          <% groupsSeen.forEach(function (gl) { %>
            <div>
              <strong><%= gl %></strong>
              <% featureCatalog.filter(function (f) { return f.group_label === gl }).forEach(function (f) {
                   var on = presentFeatureIds.indexOf(f.id) >= 0; var m = manualFeatures.find(function (x) { return x.feature_id === f.id }); %>
                <% if (f.derive) { %>
                  <div class="muted" style="font-size:.9rem;padding:3px 0"><%= on ? '✓' : '–' %> <%= f.label %> <small>(aus Fakten)</small></div>
                <% } else { %>
                  <div style="display:flex;flex-wrap:wrap;gap:2px 8px;align-items:center;margin:2px 0;font-size:.9rem">
                    <label class="inline" style="margin:0"><input type="checkbox" name="features" value="<%= f.id %>" <%= m ? 'checked' : '' %>> <span><%= f.label %></span></label>
                    <% if (m && m.trust_level === 4) { %>
                      <span class="badge warn">automatisch</span>
                      <label class="inline" style="margin:0;font-weight:400"><input type="checkbox" name="confirm_<%= f.id %>"> <small>bestätigen</small></label>
                      <% if (m.evidence_url) { %><a href="<%= m.evidence_url %>" target="_blank" rel="noopener"><small>Fundstelle</small></a><% } %>
                    <% } %>
                  </div>
                <% } %>
              <% }) %>
            </div>
          <% }) %>
        </div>
        <p style="margin-bottom:0"><button class="btn small" type="submit">Leistungen speichern</button></p>
      </form>
    </section>

    <section class="card" style="margin-top:16px" id="text" data-tab="inhalte">
      <h2 style="margin-top:0">Beschreibungstext</h2>
      <p class="muted" style="margin-top:0"><small>Steht auf der Profilseite über den Fakten; die Kurzbeschreibung ist zugleich die Meta-Beschreibung für Google. Der KI-Entwurf beruht nur auf den geprüften Daten dieser Seite. Öffentlich erst nach Freigabe.</small></p>
      <p>
        <% var hasText = text && text.body; if (!hasText) { %><span class="badge">noch kein Text</span>
        <% } else { %>
          <span class="badge <%= text.status === 'published' ? 'good' : 'warn' %>"><%= text.status === 'published' ? 'freigegeben' : 'Entwurf' %></span>
          <% if (textStale) { %><span class="badge bad" title="Fakten, Klima oder Leistungen haben sich seit dem Erzeugen bzw. der Freigabe geändert">veraltet – Fakten geändert</span><% } %>
          <small class="muted"><%= text.model ? 'erzeugt mit ' + text.model + (text.generated_at ? ' am ' + new Date(text.generated_at).toLocaleString('de-DE') : '') : 'von Hand geschrieben' %><%= text.published_at ? ' · freigegeben am ' + new Date(text.published_at).toLocaleString('de-DE') : '' %></small>
        <% } %>
      </p>
      <form method="post" action="/admin/meldungen/<%= sub.id %>/text/notizen" style="margin-bottom:14px" data-busy="Wird gespeichert …">
        <label for="t-notes">Redaktionelle Notizen <small class="muted">eigene Einschätzung in Stichworten – fließt in den KI-Entwurf ein, erscheint nicht direkt auf der Seite</small></label>
        <textarea id="t-notes" name="notes" rows="3" maxlength="3000" placeholder="z. B. viel Wind, wenig Streckenvielfalt · direkt am Strand · Sportlerbahnen gegen Aufpreis · ganze Anlage auf Sportler ausgerichtet"><%= text ? text.notes : '' %></textarea>
        <button class="btn small secondary" type="submit">Notizen speichern</button>
        <small class="muted">Danach „Neu erzeugen“, damit der Entwurf sie berücksichtigt. <a href="/admin/ki-texte">So entsteht der Text ↗</a></small>
      </form>
      <form method="post" action="/admin/meldungen/<%= sub.id %>/text/erzeugen" style="margin-bottom:12px" data-busy="Text wird erzeugt … (ca. 20 Sekunden)"
            <% if (hasText) { %>data-confirm="Den bisherigen Text durch einen neuen Entwurf ersetzen?"<% } %>>
        <button class="btn small secondary" type="submit"><%= hasText ? 'Neu erzeugen' : 'Entwurf erzeugen' %></button>
        <small class="muted">ca. 3 Cent</small>
      </form>
      <form method="post" action="/admin/meldungen/<%= sub.id %>/text">
        <label for="t-summary">Kurzbeschreibung <small class="muted">ein Satz, max. <%= SUMMARY_MAX %> Zeichen</small></label>
        <input id="t-summary" name="summary" type="text" maxlength="<%= SUMMARY_MAX %>" value="<%= text ? text.summary : '' %>">
        <label for="t-body">Text <small class="muted">Absätze durch Leerzeile trennen · „## “ = Zwischenüberschrift · „- “ = Aufzählung</small></label>
        <textarea id="t-body" name="body" rows="14"><%= text ? text.body : '' %></textarea>
        <% if (text && text.generated_body && (text.generated_body !== text.body || text.generated_summary !== text.summary)) { %>
          <details style="margin:6px 0 10px"><summary><small>Ursprünglichen KI-Entwurf ansehen (von dir überarbeitet)</small></summary>
            <pre class="json" style="white-space:pre-wrap;margin-top:6px"><%= text.generated_summary %>

<%= text.generated_body %></pre></details>
        <% } %>
        <div class="filters" style="margin-bottom:0">
          <button class="btn small secondary" type="submit" name="action" value="save">Speichern</button>
          <button class="btn small" type="submit" name="action" value="publish"><%= text && text.status === 'published' ? 'Erneut freigeben' : 'Freigeben' %></button>
          <% if (text && text.status === 'published') { %><button class="btn small secondary" type="submit" name="action" value="unpublish">Zurückziehen</button><% } %>
        </div>
      </form>
    </section>

    <section class="card" style="margin-top:16px" id="anfragen" data-tab="kommunikation">
      <h2 style="margin-top:0">Anfragen an den Betreiber</h2>
      <% var draftInq = inquiryList.find(function (i) { return i.status === 'draft' });
         var openInq = inquiryList.find(function (i) { return i.status === 'queued' || i.status === 'sent' });
         var askable = criteria.filter(function (c) { return c.scoring.type === 'option' || c.scoring.type === 'bool' });
         var unclearIds = unclear.map(function (c) { return c.id });
         var hasApprovedImage = images.some(function (i) { return i.approved_at }); %>
      <% if (!entity.contact_email) { %>
        <p class="errors" style="margin:0">Für Anfragen fehlt die Kontakt-E-Mail des Betreibers (Stammdaten).</p>
      <% } else if (draftInq) { var draftIds = draftInq.criteria_ids; %>
        <form method="post" action="/admin/anfragen/<%= draftInq.id %>/formulieren" class="draft-box" data-busy="Der Agent formuliert …">
          <input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#anfragen">
          <p style="margin-top:0"><span class="badge warn">Entwurf</span> <strong>Anfrage an <%= draftInq.recipient %></strong>
            <small class="muted">· <%= draftInq.auto_created ? 'automatisch angelegt' : 'angelegt' %> <%= formatDate(draftInq.created_at) %><%= draftInq.persona_id && personas[draftInq.persona_id] ? ' · schreibt: ' + personas[draftInq.persona_id] + ' (KI)' : '' %></small></p>
          <p class="muted" style="margin:0 0 6px"><small><strong>Schritt 1:</strong> Auswahl anpassen und formulieren lassen – der Agent schreibt die Mail in der Sprache des Betreibers (<%= draftInq.language.toUpperCase() %>). Gesendet wird erst in Schritt 2.</small></p>
          <div class="grid grid-2" style="gap:2px 16px;margin:6px 0 10px">
            <% askable.filter(function (c) { return draftIds.indexOf(c.id) >= 0 || unclearIds.indexOf(c.id) >= 0 }).forEach(function (c) { var f = factByCrit[c.id]; %>
              <label class="inline" style="margin:0"><input type="checkbox" name="criteria" value="<%= c.id %>" <%= draftIds.indexOf(c.id) >= 0 && unclearIds.indexOf(c.id) >= 0 ? 'checked' : '' %>>
                <span><%= c.label %> <small class="muted"><%= !f ? 'unbekannt' : f.disputed ? 'strittig' : f.trust_level === 4 ? 'Vorschlag' : 'geprüft' %></small></span></label>
            <% }) %>
          </div>
          <%- include('_confirm-block', {
                sel: draftInq.body ? { criteriaIds: draftInq.confirm_criteria_ids || [], featureIds: draftInq.confirm_feature_ids || [] } : confirmDefaults(draftIds),
                offerChecked: draftInq.body ? (draftInq.offer_feature_ids || []).length > 0 : true }) %>
          <label class="inline"><input type="checkbox" name="ask_photos" <%= draftInq.ask_photos ? 'checked' : '' %>> <span>Fotos mit Nutzungserlaubnis anfragen</span></label>
          <label for="draft-note">Hinweis an den Agenten <small class="muted">optional</small></label>
          <textarea id="draft-note" name="note" style="min-height:50px"><%= draftInq.admin_note || '' %></textarea>
          <div class="filters" style="margin-bottom:0">
            <button class="btn <%= draftInq.body ? 'secondary' : '' %>" type="submit"><%= draftInq.body ? 'Neu formulieren' : 'Entwurf formulieren' %></button>
            <button class="btn small secondary" type="submit" formaction="/admin/anfragen/<%= draftInq.id %>/verwerfen" formnovalidate>Entwurf verwerfen</button>
          </div>
        </form>
        <% if (draftInq.body) { %>
          <form method="post" action="/admin/anfragen/<%= draftInq.id %>/freigeben" class="draft-box" style="margin-top:12px" data-confirm="Anfrage jetzt an <%= draftInq.recipient %> senden?">
            <input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#anfragen">
            <p class="muted" style="margin-top:0"><small><strong>Schritt 2:</strong> Text prüfen, bei Bedarf anpassen und senden. <code>{{LINK}}</code> wird beim Versand durch den persönlichen Antwortlink ersetzt – bitte stehen lassen.<% if (draftInq.error) { %> <span style="color:var(--bad)"><%= draftInq.error %></span><% } %></small></p>
            <label for="draft-subject">Betreff</label>
            <input id="draft-subject" name="subject" required maxlength="150" value="<%= draftInq.subject %>">
            <label for="draft-body">Text</label>
            <textarea id="draft-body" name="body" required style="min-height:260px"><%= draftInq.body %></textarea>
            <% if ((draftInq.questions || []).length) { %>
              <details style="margin-top:6px"><summary><small>Fragen im Antwortformular (<%= draftInq.questions.length %>)</small></summary>
                <ol style="margin:6px 0"><% draftInq.questions.forEach(function (q) { %><li><small><%= q.question %> <span class="muted">(<%= q.options.map(function (o) { return o.text; }).join(' / ') %>)</span></small></li><% }) %></ol>
              </details>
            <% } %>
            <% var dc = draftInq.confirmations || {}; var dcCrit = dc.criteria || []; var dcFeat = dc.features || []; %>
            <% if (dcCrit.length || dcFeat.length) { %>
              <details style="margin-top:6px"><summary><small>Bestätigungsliste im Antwortformular (<%= dcCrit.length %> Werte, <%= dcFeat.filter(function (f) { return f.known; }).length %> Leistungen<%= dcFeat.some(function (f) { return !f.known; }) ? ', ' + dcFeat.filter(function (f) { return !f.known; }).length + ' zum Ankreuzen' : '' %>)</small></summary>
                <ul style="margin:6px 0">
                  <% dcCrit.forEach(function (it) { %><li><small><%= it.label %>: <strong><%= it.current_text %></strong> <span class="muted">(Auswahl: <%= it.options.map(function (o) { return o.text; }).join(' / ') %>)</span></small></li><% }) %>
                  <% dcFeat.filter(function (f) { return f.known; }).forEach(function (f) { %><li><small>Leistung: <%= f.text %></small></li><% }) %>
                  <% var offerList = dcFeat.filter(function (f) { return !f.known; }); if (offerList.length) { %><li><small>„Bieten Sie außerdem …?“: <%= offerList.map(function (f) { return f.text; }).join(', ') %></small></li><% } %>
                </ul>
              </details>
            <% } %>
            <p style="margin-bottom:0"><button class="btn" type="submit">Senden</button></p>
          </form>
        <% } %>
      <% } else if (openInq) { %>
        <p class="muted">Es läuft eine offene Anfrage an <strong><%= openInq.recipient %></strong>. Eine neue ist erst nach Antwort oder Abschluss möglich.</p>
      <% } else { %>
        <form method="post" action="/admin/meldungen/<%= sub.id %>/anfrage" data-busy="Der Agent formuliert …">
          <p class="muted" style="margin-top:0">Der Agent schreibt eine sachliche Anfrage in der Sprache des Betreibers mit persönlichem Antwortlink an <strong><%= entity.contact_email %></strong>. Du prüfst den Text vor dem Senden; Antworten werden erst nach deiner Bestätigung übernommen.</p>
          <strong>Unklare Werte (<%= unclear.length %>)</strong> <small class="muted">unbekannt, strittig oder nur automatisch ermittelt</small>
          <div class="grid grid-2" style="gap:2px 16px;margin:6px 0 10px">
            <% unclear.forEach(function (c) { %>
              <label class="inline" style="margin:0"><input type="checkbox" name="criteria" value="<%= c.id %>" checked> <span><%= c.label %></span></label>
            <% }) %>
            <% if (!unclear.length) { %><span class="muted">Keine – alle Werte sind belegt.</span><% } %>
          </div>
          <details>
            <summary><small>Weitere Werte nachfragen</small></summary>
            <div class="grid grid-2" style="gap:2px 16px;margin:6px 0">
              <% askable.filter(function (c) { return unclearIds.indexOf(c.id) < 0 }).forEach(function (c) { %>
                <label class="inline" style="margin:0"><input type="checkbox" name="criteria" value="<%= c.id %>"> <span><%= c.label %></span></label>
              <% }) %>
            </div>
          </details>
          <%- include('_confirm-block', { sel: confirmDefaults(unclearIds), offerChecked: true }) %>
          <label class="inline"><input type="checkbox" name="ask_photos" <%= hasApprovedImage ? '' : 'checked' %>> <span>Fotos mit Nutzungserlaubnis anfragen</span></label>
          <label for="inq-note">Hinweis an den Agenten <small class="muted">optional, z. B. „Bahnzeiten im Winter erfragen“</small></label>
          <textarea id="inq-note" name="note" style="min-height:60px"></textarea>
          <p style="margin-bottom:0"><button class="btn" type="submit">Entwurf formulieren</button></p>
        </form>
      <% } %>

      <% inquiryList.filter(function (inq) { return inq.status !== 'draft' }).forEach(function (inq) { var personaName = inq.persona_id && personas[inq.persona_id]; var statusText = { draft: 'Entwurf', queued: 'wird formuliert', sent: 'versendet', answered: 'beantwortet', expired: 'abgelaufen', failed: 'fehlgeschlagen', closed: 'geschlossen' }[inq.status]; %>
        <div style="border-top:1px solid var(--border);margin-top:16px;padding-top:12px">
          <p style="margin:0 0 6px">
            <span class="badge <%= inq.status === 'answered' ? 'good' : inq.status === 'failed' ? 'bad' : inq.status === 'sent' ? 'accent' : '' %>"><%= statusText %></span>
            <small class="muted">gestartet <%= formatDate(inq.created_at) %><%= inq.sent_at ? ' · versendet ' + formatDate(inq.sent_at) : '' %><%= inq.reminder_sent_at ? ' · erinnert ' + formatDate(inq.reminder_sent_at) : '' %><%= inq.answered_at ? ' · Antwort ' + formatDate(inq.answered_at) : '' %> · <%= inq.criteria_ids.length %> Fragen<% var nConf = (inq.confirm_criteria_ids || []).length + (inq.confirm_feature_ids || []).length; %><%= nConf ? ' + ' + nConf + ' Bestätigungen' : '' %><%= inq.ask_photos ? ' + Fotos' : '' %> · <%= inq.language.toUpperCase() %><%= personaName ? ' · von ' + personaName + ' (KI)' : '' %></small>
          </p>
          <% if (inq.error) { %><p style="color:var(--bad);margin:0 0 6px"><small><%= inq.error %></small></p><% } %>
          <% if (inq.body) { %>
            <details><summary><small>Mail ansehen: <%= inq.subject %></small></summary><pre class="json" style="margin-top:6px"><%= inq.body.replace('{{LINK}}', '[persönlicher Antwortlink]') %></pre></details>
          <% } %>
          <% if (inq.reply_note || inq.reply_name) { %><p style="margin:8px 0"><strong>Nachricht<%= inq.reply_name ? ' von ' + inq.reply_name : '' %>:</strong> <%= inq.reply_note || '–' %></p><% } %>
          <% var featureAnswers = inq.featureAnswers || [];
             var sameValue = function (a) { return a.kind === 'confirm' && JSON.stringify(a.value) === JSON.stringify(a.previous); };
             var bulkN = inq.answers.filter(function (a) { return a.status === 'pending' && sameValue(a); }).length
               + featureAnswers.filter(function (a) { return a.status === 'pending' && a.known && a.offered; }).length; %>
          <% if (bulkN) { %>
            <form method="post" action="/admin/anfragen/<%= inq.id %>/bestaetigungen-uebernehmen" style="margin:8px 0">
              <input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#anfragen">
              <button class="btn small" type="submit">Alle <%= bulkN %> Bestätigungen übernehmen</button>
              <small class="muted">unveränderte Werte und weiter angebotene Leistungen als „vom Betreiber“ – Korrekturen und neue Leistungen einzeln prüfen</small>
            </form>
          <% } %>
          <% if (inq.answers.length) { %>
            <div class="table-scroll">
            <table>
              <tr><th>Kriterium</th><th>Antwort</th><th>Bisher</th><th></th></tr>
              <% inq.answers.forEach(function (a) { var c = criteria.find(function (x) { return x.id === a.criterion_id }); var f = factByCrit[a.criterion_id]; %>
                <tr>
                  <td><%= c ? c.label : '–' %><% if (a.kind === 'confirm') { %> <span class="badge <%= sameValue(a) ? 'good' : 'warn' %>"><%= sameValue(a) ? 'bestätigt' : 'korrigiert' %></span><% } %></td>
                  <td><strong><%= a.value ? ((c && describeValue(c, a.value)) || JSON.stringify(a.value)) : 'weiß nicht' %></strong><% if (a.comment) { %><br><small class="muted">„<%= a.comment %>“</small><% } %></td>
                  <td><small class="muted"><%= f && c ? (describeValue(c, f.value) || '') + ' (Stufe ' + f.trust_level + ')' : 'unbekannt' %></small></td>
                  <td style="white-space:nowrap">
                    <% if (a.status === 'pending') { %>
                      <form method="post" action="/admin/antworten/<%= a.id %>/uebernehmen" style="display:inline"><input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#anfragen"><button class="btn small" type="submit" <%= a.value ? '' : 'disabled' %>>Übernehmen</button></form>
                      <form method="post" action="/admin/antworten/<%= a.id %>/verwerfen" style="display:inline"><input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#anfragen"><button class="btn small secondary" type="submit">Verwerfen</button></form>
                    <% } else { %><span class="badge <%= a.status === 'accepted' ? 'good' : '' %>"><%= a.status === 'accepted' ? 'übernommen' : 'verworfen' %></span><% } %>
                  </td>
                </tr>
              <% }) %>
            </table>
            </div>
          <% } %>
          <% if (featureAnswers.length) { %>
            <div class="table-scroll">
            <table style="margin-top:8px">
              <tr><th>Leistung</th><th>Laut Betreiber</th><th>Bisher</th><th></th></tr>
              <% featureAnswers.forEach(function (a) { %>
                <tr>
                  <td><%= a.label %></td>
                  <td><strong><%= a.offered ? 'wird angeboten' : 'wird nicht angeboten' %></strong>
                    <% if (a.known && !a.offered) { %> <span class="badge warn">entfernen</span><% } else if (!a.known) { %> <span class="badge accent">neu</span><% } else { %> <span class="badge good">bestätigt</span><% } %></td>
                  <td><small class="muted"><%= a.known ? 'erfasst' : 'nicht erfasst' %></small></td>
                  <td style="white-space:nowrap">
                    <% if (a.status === 'pending') { %>
                      <form method="post" action="/admin/leistungs-antworten/<%= a.id %>/uebernehmen" style="display:inline"><input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#anfragen"><button class="btn small" type="submit">Übernehmen</button></form>
                      <form method="post" action="/admin/leistungs-antworten/<%= a.id %>/verwerfen" style="display:inline"><input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#anfragen"><button class="btn small secondary" type="submit">Verwerfen</button></form>
                    <% } else { %><span class="badge <%= a.status === 'accepted' ? 'good' : '' %>"><%= a.status === 'accepted' ? 'übernommen' : 'verworfen' %></span><% } %>
                  </td>
                </tr>
              <% }) %>
            </table>
            </div>
          <% } %>
          <% var inqImages = images.filter(function (i) { return i.inquiry_id === inq.id }); if (inqImages.length) { %>
            <p style="margin:8px 0 0"><small><%= inqImages.length %> Foto(s) mit Nutzungserlaubnis eingegangen – <a href="#bilder">unten bei Bilder freigeben</a>.</small></p>
          <% } %>
          <% if (['queued', 'sent', 'failed'].indexOf(inq.status) >= 0) { %>
            <form method="post" action="/admin/anfragen/<%= inq.id %>/schliessen" style="margin-top:8px"><input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#anfragen"><button class="btn small secondary" type="submit">Anfrage schließen</button></form>
          <% } %>
        </div>
      <% }) %>
    </section>

    <section class="card" style="margin-top:16px" id="einwilligungen" data-tab="stammdaten">
      <h2 style="margin-top:0">Einwilligungen des Betreibers</h2>
      <p class="muted" style="margin-top:0">Grundlage für automatisierte Abläufe: Ohne gültige Einwilligung werden keine Fotos in Social Media gepostet und keine Kooperationsmails verschickt.</p>
      <% Object.keys(CONSENT_TYPES).forEach(function (type) { var active = consents.find(function (c) { return c.type === type && !c.withdrawn_at }); %>
        <div style="display:flex;flex-wrap:wrap;gap:6px 12px;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)">
          <strong style="flex:1 1 14em"><%= CONSENT_TYPES[type] %></strong>
          <% if (active) { %>
            <span class="badge good">erteilt <%= formatDate(active.granted_at) %></span>
            <small class="muted"><%= active.source === 'inquiry' ? 'über Anfrage' : 'vom Admin erfasst' %><%= active.contact_name ? ' · ' + active.contact_name : '' %><%= active.contact_email ? ' · ' + active.contact_email : '' %> · Wortlaut <%= active.text_version %></small>
            <details style="flex-basis:100%"><summary><small>Wortlaut und Widerruf</small></summary>
              <p style="margin:6px 0"><small><%= active.text %></small></p>
              <% if (active.note) { %><p style="margin:6px 0"><small class="muted">Notiz: <%= active.note %></small></p><% } %>
              <form method="post" action="/admin/einwilligungen/<%= active.id %>/widerrufen" class="filters" style="margin:6px 0">
                <input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#einwilligungen">
                <input type="text" name="note" placeholder="Anlass, z. B. Mail vom …" style="flex:1;min-width:12em">
                <button class="btn small danger" type="submit">Widerruf erfassen</button>
              </form>
            </details>
          <% } else { %>
            <span class="badge">keine</span>
          <% } %>
        </div>
      <% }) %>
      <% var withdrawn = consents.filter(function (c) { return c.withdrawn_at }); if (withdrawn.length) { %>
        <p style="margin:10px 0 0"><small class="muted">Widerrufen: <%= withdrawn.map(function (c) { return CONSENT_TYPES[c.type] + ' (' + formatDate(c.withdrawn_at) + ')' }).join(', ') %></small></p>
      <% } %>
      <details style="margin-top:12px">
        <summary><small>Einwilligung manuell erfassen (z. B. schriftlich oder telefonisch bestätigt)</small></summary>
        <form method="post" action="/admin/objekte/<%= entity.id %>/einwilligungen">
          <input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>#einwilligungen">
          <input type="hidden" name="site_id" value="<%= ranking.site_id %>">
          <div class="form-row">
            <div><label>Art</label><select name="type"><% Object.keys(CONSENT_TYPES).forEach(function (t) { %><option value="<%= t %>"><%= CONSENT_TYPES[t] %></option><% }) %></select></div>
            <div><label>Name</label><input type="text" name="contact_name"></div>
            <div><label>E-Mail</label><input type="email" name="contact_email" value="<%= entity.contact_email || '' %>"></div>
          </div>
          <label>Nachweis *</label><input type="text" name="note" required placeholder="z. B. Mail vom 12.10.2026, abgelegt unter …">
          <p><button class="btn small" type="submit">Erfassen</button></p>
        </form>
      </details>
    </section>

    <section class="card" style="margin-top:16px" id="bilder" data-tab="inhalte">
      <h2 style="margin-top:0">Bilder</h2>
      <p class="muted">Nur mit dokumentierter Berechtigung. Keine Fotos von fremden Websites übernehmen. Öffentlich erst nach Freigabe und solange die Rechte gültig sind.</p>
      <% images.forEach(function (img) { %>
        <div class="grid grid-2" style="border-bottom:1px solid var(--border);padding:10px 0">
          <img src="/admin/bilder/<%= img.id %>/datei" alt="" style="max-height:160px;object-fit:cover">
          <div>
            <small><%= IMAGE_SOURCES[img.source] %> · <%= img.license %> · © <%= String(img.credit).replace(/^\s*(©|\(c\))\s*/i, "") %><br>
              Nachweis: <%= img.release_proof %><br>
              <%= img.valid_until ? 'gültig bis ' + formatDate(img.valid_until) : 'unbefristet' %><%= img.is_primary ? ' · Hauptbild' : '' %></small><br>
            <% if (img.approved_at) { %><span class="badge good">freigegeben <%= formatDate(img.approved_at) %></span>
            <% } else { %>
              <form method="post" action="/admin/bilder/<%= img.id %>/freigeben" style="display:inline"><input type="hidden" name="submission_id" value="<%= sub.id %>"><button class="btn small" type="submit">Freigeben</button></form>
            <% } %>
            <form method="post" action="/admin/bilder/<%= img.id %>/loeschen" style="display:inline">
              <input type="hidden" name="submission_id" value="<%= sub.id %>">
              <input type="hidden" name="reason" value="Admin">
              <button class="btn small danger" type="submit">Entfernen</button>
            </form>
          </div>
        </div>
      <% }) %>
      <details style="margin-top:12px">
        <summary>Bild hochladen <small class="muted">(<%= images.length %> von <%= MAX_IMAGES %>)</small></summary>
        <form method="post" action="/admin/objekte/<%= entity.id %>/bilder" enctype="multipart/form-data">
          <input type="hidden" name="submission_id" value="<%= sub.id %>">
          <label>Datei (JPG, PNG, WebP, max. 8 MB – wird automatisch verkleinert) *</label><input type="file" name="file" accept="image/jpeg,image/png,image/webp" required>
          <div class="form-row">
            <div><label>Quelle *</label><select name="source" required><% Object.keys(IMAGE_SOURCES).forEach(function (k) { %><option value="<%= k %>"><%= IMAGE_SOURCES[k] %></option><% }) %></select></div>
            <div><label>Lizenz *</label><input name="license" type="text" required placeholder="z. B. Freigabe Hotel, CC BY 4.0"></div>
          </div>
          <div class="form-row">
            <div><label>Urhebervermerk *</label><input name="credit" type="text" required></div>
            <div><label>Fundstelle / Lizenzseite</label><input name="source_url" type="url"></div>
          </div>
          <div class="form-row">
            <div><label>Nachweis der Freigabe *</label><input name="release_proof" type="text" required placeholder="z. B. Mail vom 12.10.2026, Ablage …"></div>
            <div><label>Rechte gültig bis</label><input name="valid_until" type="date"></div>
          </div>
          <label class="inline"><input type="checkbox" name="is_primary"> Hauptbild</label>
          <p><button class="btn small" type="submit">Hochladen</button></p>
        </form>
      </details>
    </section>
    <% } %>

    <section class="card" style="margin-top:16px" id="ki-kosten" data-tab="verlauf">
      <h2 style="margin-top:0">KI-Verbrauch</h2>
      <%
        var PURPOSES = { extraction: 'Website-Auswertung', inquiry: 'Anfrage-Entwurf', description: 'Beschreibungstext', compare: 'Modellvergleich' };
        var usd = function (n) { return Number(n).toFixed(2).replace('.', ',') + ' $'; };
        var tok = function (n) { return Number(n).toLocaleString('de-DE'); };
        var total = llmUsage.reduce(function (a, u) { return a + Number(u.cost_usd); }, 0);
      %>
      <% if (!llmUsage.length) { %>
        <p class="muted">Für dieses Objekt wurde noch kein KI-Aufruf gespeichert.</p>
      <% } else { %>
        <div class="table-scroll">
          <table>
            <tr><th>Zeitpunkt</th><th>Zweck</th><th>Modell</th><th>Tokens ein</th><th>Tokens aus</th><th>Kosten (ca.)</th></tr>
            <% llmUsage.forEach(function (u) { %>
              <tr>
                <td><%= new Date(u.created_at).toLocaleString('de-DE') %></td>
                <td><%= PURPOSES[u.purpose] || u.purpose %></td>
                <td><small><%= u.model %></small></td>
                <td><%= tok(u.input_tokens + u.cache_read_tokens + u.cache_write_tokens) %></td>
                <td><%= tok(u.output_tokens) %></td>
                <td><%= usd(u.cost_usd) %></td>
              </tr>
            <% }) %>
            <tr><th colspan="5">Summe dieses Objekts</th><th><%= usd(total) %></th></tr>
          </table>
        </div>
      <% } %>
      <p class="muted" style="margin-bottom:0"><small>Laufender Monat, alle Objekte: <%= usd(llmMonth.usd) %> bei <%= llmMonth.calls %> Aufrufen<%= llmMonth.budget ? ' · Budget ' + usd(llmMonth.budget) : ' · kein Monatsbudget gesetzt' %>. Kosten sind Schätzungen nach Listenpreis; maßgeblich ist die Abrechnung in der Claude Console.</small></p>
    </section>

    <% if (entity) { %>
    <section class="card" style="margin-top:16px" id="postfach" data-tab="kommunikation">
      <h2 style="margin-top:0">E-Mail-Verlauf</h2>
      <% if (mailThread.length) { %><%- include('_mail-thread', { thread: mailThread, current: null }) %>
      <% } else { %><p class="muted">Noch keine Mails mit diesem <%= ranking.entity_label_sg %>. Antworten auf Anfragen erscheinen hier automatisch.</p><% } %>
      <details style="margin-top:12px" <%= mailThread.length ? '' : 'open' %>><summary>Neue Nachricht schreiben</summary>
        <form method="post" action="/admin/postfach/neu" style="margin-top:8px">
          <input type="hidden" name="entity" value="<%= entity.id %>"><input type="hidden" name="back" value="/admin/meldungen/<%= sub.id %>">
          <div class="grid grid-2" style="gap:0 16px">
            <div><label for="nm-to">An</label><input id="nm-to" name="to" type="email" required value="<%= entity.contact_email || '' %>"></div>
            <div><label for="nm-persona">Absender</label>
              <select id="nm-persona" name="persona"><option value="">Team (ohne Persona)</option>
                <% mailPersonas.forEach(function (p) { %><option value="<%= p.id %>" <%= p.id === mailDefaultPersona ? 'selected' : '' %>><%= p.name %> – <%= p.title %></option><% }) %></select></div>
          </div>
          <label for="nm-subject">Betreff</label><input id="nm-subject" name="subject" required maxlength="300" value="<%= entity.name %>">
          <label for="nm-text">Text</label>
          <textarea id="nm-text" name="text" required style="min-height:160px">Hallo,


Viele Grüße</textarea>
          <p class="muted" style="margin:4px 0 8px"><small>Signatur der Persona wird angehängt. Für Fragen zu einzelnen Angaben besser oben „Anfrage“ nutzen – dann können Betreiber per Link antworten.</small></p>
          <button class="btn" type="submit">Senden</button>
        </form>
      </details>
    </section>
    <% } %>

    <% if (emails.length) { %>
      <section class="card" style="margin-top:16px" id="mails" data-tab="kommunikation">
        <h2 style="margin-top:0">Mails zur Meldung</h2>
        <ul class="log-list"><% emails.forEach(function (m) { %><li><%= new Date(m.created_at).toLocaleString('de-DE') %> · <%= m.template %> an <%= m.recipient %> · <span class="badge <%= m.status === 'sent' ? 'good' : 'bad' %>"><%= m.status %></span></li><% }) %></ul>
      </section>
    <% } %>
  </div>

  <aside>
    <div class="card">
      <div class="muted"><%= ranking.score_name %> (Vorschau)</div>
      <div style="display:flex;gap:12px;align-items:center;margin:8px 0">
        <span class="score big <%= result.score === null ? 'none' : '' %>" id="pv-score"><%= result.score === null ? '–' : result.score %></span>
        <div><strong id="pv-label"><%= result.label || '' %></strong><br><small class="muted" id="pv-eligible"><%= result.eligible ? 'im Ranking' : 'nicht im Ranking' %></small></div>
      </div>
      <p style="margin:0">F <strong id="pv-f"><%= result.factScore === null ? '–' : result.factScore %></strong> · Vollst. <strong id="pv-c"><%= result.completeness %></strong> %</p>
      <p id="pv-ko" class="<%= result.ko ? '' : 'hidden' %>" style="color:var(--bad)<%= result.ko ? '' : ';display:none' %>">K.O.: <span><%= result.koReason || '' %></span></p>
    </div>

    <% if (sub.status === 'live' && entity) { %>
      <div class="card" style="margin-top:12px">
        <form method="post" action="/admin/meldungen/<%= sub.id %>/aktualisieren">
          <button class="btn small secondary" type="submit" style="width:100%">Daten aktualisieren</button>
        </form>
        <p class="muted" style="margin:6px 0 0"><small>Wiederholt die Auto-Prüfung (Website, Koordinaten, Klima, Umgebung). Das <%= ranking.entity_label_sg %> bleibt online; neue Werte kommen nur als Vorschläge hinzu, deine Einträge bleiben unverändert.</small></p>
      </div>
    <% } %>

    <% if (['received', 'expired'].includes(sub.status)) { %>
      <div class="card" style="margin-top:12px">
        <p style="margin-top:0"><strong><%= sub.status === 'expired' ? 'Bestätigungslink abgelaufen' : 'Wartet auf E-Mail-Bestätigung' %></strong><br>
          <small class="muted">Die Auto-Prüfung startet erst, wenn der Melder den Link in seiner Mail anklickt. Du kannst sie auch selbst starten. Die Adresse <%= sub.submitter_email || '' %> gilt dann als unbestätigt und bekommt keine Mails von uns.</small></p>
        <form method="post" action="/admin/meldungen/<%= sub.id %>/bestaetigen">
          <button class="btn" type="submit" style="width:100%">Ohne Bestätigung prüfen</button>
        </form>
        <details style="margin-top:10px">
          <summary>Ablehnen (z. B. Spam)</summary>
          <form method="post" action="/admin/meldungen/<%= sub.id %>/ablehnen">
            <textarea name="reason" required placeholder="Begründung (intern, keine Mail an unbestätigte Adressen)"></textarea>
            <button class="btn small danger" type="submit">Ablehnen</button>
          </form>
        </details>
      </div>
    <% } %>

    <% if (['admin_review', 'auto_check', 'basics', 'verified'].includes(sub.status)) { %>
      <div class="card" style="margin-top:12px">
        <form method="post" action="/admin/meldungen/<%= sub.id %>/freigeben">
          <button class="btn" type="submit" style="width:100%" <%= entity && !result.ko && !sub.possible_duplicate_of && sub.status !== 'basics' ? '' : 'disabled' %> <%= sub.status === 'basics' ? 'title="Erst nach vollständigen Grunddaten und Auto-Prüfung"' : '' %>><%= sub.submitter_email && sub.verified_at && !sub.verified_by ? 'Freigeben & Mail senden' : 'Freigeben' %></button>
        </form>
        <% if (entity && !entity.contact_email) { %><p class="muted" style="margin:6px 0 0"><small>Ohne Kontakt-E-Mail keine Anfragen an das <%= ranking.entity_label_sg %> möglich (Stammdaten).</small></p><% } %>
        <details style="margin-top:10px">
          <summary>Ablehnen</summary>
          <form method="post" action="/admin/meldungen/<%= sub.id %>/ablehnen">
            <textarea name="reason" required placeholder="Begründung (geht per Mail an den Melder)"><%= result.ko ? 'K.O.-Kriterium nicht erfüllt – ' + result.koReason : '' %></textarea>
            <button class="btn small danger" type="submit">Ablehnen &amp; Mail senden</button>
          </form>
        </details>
        <details style="margin-top:10px">
          <summary>Zurückstellen</summary>
          <form method="post" action="/admin/meldungen/<%= sub.id %>/zurueckstellen">
            <textarea name="note" placeholder="Notiz"><%= sub.admin_note || '' %></textarea>
            <button class="btn small secondary" type="submit">Notiz speichern</button>
          </form>
        </details>
        <form method="post" action="/admin/meldungen/<%= sub.id %>/pruefen" style="margin-top:10px">
          <button class="btn small secondary" type="submit">Auto-Prüfung erneut starten</button>
        </form>
      </div>
    <% } %>
  </aside>
</div>

<% locals.scripts = ['/static/js/admin.js', '/static/js/geo-pick.js'] %>
<%- include('../partials/admin-foot') %>
