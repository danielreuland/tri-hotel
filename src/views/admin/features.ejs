<%- include('../partials/admin-head') %>
<h1>Leistungskatalog</h1>
<p class="muted">Eine Leistung hat bei allen <%= types.join(', ') %>-Einträgen denselben Namen. Umbenennen wirkt sofort überall. Leistungen mit Ableitung ergeben sich aus einem Fakt im Ranking; die übrigen werden je Objekt gepflegt.</p>
<% if (errors.length) { %><div class="errors"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div><% } %>

<div class="table-scroll">
<table>
  <tr><th>Gruppe</th><th>Name</th><th>Code</th><th>Herkunft</th><th class="num">Reihenf.</th><th>Filter</th><th>aktiv</th><th></th></tr>
  <% rows.forEach(function (f) { var fid = 'f-' + f.id; %>
    <tr>
      <td><input form="<%= fid %>" name="group_label" type="text" value="<%= f.group_label %>" style="min-width:8em"></td>
      <td><input form="<%= fid %>" name="label" type="text" value="<%= f.label %>" style="min-width:14em"></td>
      <td><code><%= f.code %></code><br><small class="muted"><%= f.entity_type %></small></td>
      <td><small><% if (f.derive) { %>aus Fakt <code><%= f.derive.criterion %></code><% } else { %>gepflegt (<%= usage[f.id] || 0 %>×)<% } %></small>
        <input form="<%= fid %>" name="derive" type="hidden" value="<%= f.derive ? JSON.stringify(f.derive) : '' %>"></td>
      <td class="num"><input form="<%= fid %>" name="sort_order" type="number" value="<%= f.sort_order %>" style="width:5em"></td>
      <td><input form="<%= fid %>" name="filterable" type="checkbox" <%= f.filterable ? 'checked' : '' %> title="in der Suchmaske anbieten"></td>
      <td><input form="<%= fid %>" name="active" type="checkbox" <%= f.active ? 'checked' : '' %>></td>
      <td><form id="<%= fid %>" method="post" action="/admin/leistungen/<%= f.id %>"><button class="btn small secondary" type="submit">Speichern</button></form></td>
    </tr>
  <% }) %>
</table>
</div>

<h2>Neue Leistung</h2>
<form method="post" action="/admin/leistungen" class="card">
  <div class="form-row">
    <div><label>Objekttyp</label><select name="entity_type"><% types.forEach(function (t) { %><option value="<%= t %>"><%= t %></option><% }) %></select></div>
    <div><label>Name *</label><input name="label" type="text" required placeholder="z. B. Höhentrainingsraum"></div>
    <div><label>Gruppe *</label><input name="group_label" type="text" required placeholder="z. B. Indoor-Training"></div>
    <div><label>Code *</label><input name="code" type="text" required placeholder="z. B. altitude_room"></div>
    <div><label>Reihenfolge</label><input name="sort_order" type="number" value="100"></div>
  </div>
  <label>Ableitung aus einem Fakt (optional, JSON)</label>
  <input name="derive" type="text" placeholder='{"ranking":"triathlon-hotel","criterion":"rec_sauna","values":[true]}'>
  <label class="inline"><input type="checkbox" name="filterable"> in der Suchmaske als Filter anbieten</label>
  <p style="margin-bottom:0"><button class="btn" type="submit">Anlegen</button></p>
</form>
<%- include('../partials/admin-foot') %>
