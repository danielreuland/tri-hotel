<%- include('../partials/admin-head') %>
<h1>Warteschlange</h1>
<% var countOf = function (s) { var c = counts.find(function (x) { return x.status === s }); return c ? c.n : 0 };
   var total = counts.reduce(function (sum, x) { return sum + x.n }, 0);
   var order = ['admin_review'].concat(Object.keys(STATUS_LABELS).filter(function (s) { return s !== 'admin_review' })); %>
<div class="pill-row">
  <% order.forEach(function (s) { %>
    <a class="badge <%= status === s ? 'accent' : '' %>" href="/admin?status=<%= s %><%= rankingId ? '&ranking=' + rankingId : '' %>"><%= STATUS_LABELS[s] %> (<%= countOf(s) %>)</a>
  <% }) %>
  <a class="badge <%= status === null ? 'accent' : '' %>" href="/admin?status=alle<%= rankingId ? '&ranking=' + rankingId : '' %>">alle (<%= total %>)</a>
</div>
<form class="filters" method="get">
  <input type="hidden" name="status" value="<%= status || 'alle' %>">
  <select name="ranking" data-autosubmit>
    <option value="">alle Rankings</option>
    <% allRankings.forEach(function (r) { %><option value="<%= r.id %>" <%= rankingId === r.id ? 'selected' : '' %>><%= r.name %></option><% }) %>
  </select>
</form>
<div class="table-scroll">
<table>
  <tr><th>Eingang</th><th>Name</th><th>Ranking</th><th>Status</th><th class="num">Score</th><th class="num">Vollst.</th><th>Hinweis</th></tr>
  <% rows.forEach(function (r) { %>
    <tr>
      <td><%= formatDate(r.created_at) %></td>
      <td><a href="/admin/meldungen/<%= r.id %>"><%= r.entity_name %></a><br><small><%= r.city %>, <%= r.country %><%= r.created_by_admin ? ' · Admin' : '' %></small></td>
      <td><small><%= r.ranking_name %></small></td>
      <td><span class="badge"><%= STATUS_LABELS[r.status] %></span></td>
      <% var incomplete = r.completeness !== null && r.completeness !== undefined && Number(r.completeness) < (r.min_completeness || 70); %>
      <td class="num"><% if (r.score === null || r.score === undefined) { %>–<% } else if (incomplete) { %><span class="muted" title="Nur wenige Werte bekannt – der Score ist noch nicht aussagekräftig"><%= r.score %></span><br><small class="muted">unvollständig</small><% } else { %><%= r.score %><% } %></td>
      <td class="num"><%= r.completeness === null || r.completeness === undefined ? '–' : Math.round(r.completeness) + ' %' %></td>
      <td><% if (r.ko_reason) { %><span class="badge bad">K.O.</span> <small><%= r.ko_reason %></small><% } %><% if (r.admin_note) { %><small>📝 <%= r.admin_note %></small><% } %></td>
    </tr>
  <% }) %>
  <% if (!rows.length) { %><tr><td colspan="7" class="muted">Keine Meldungen in diesem Status.</td></tr><% } %>
</table>
</div>
<% locals.scripts = ['/static/js/site.js'] %>
<%- include('../partials/admin-foot') %>
