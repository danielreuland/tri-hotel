<%- include('../partials/admin-head') %>
<h1>Partnerprogramme</h1>
<p class="muted">Partnerlinks erscheinen auf Profilseiten im Kasten „Buchen &amp; Anfragen“ als <strong>Anzeige</strong> – in der hier festgelegten Reihenfolge (der erste aktive Preis-Anbieter ist der Hauptknopf „Preise prüfen“), ohne Einfluss auf Score, Reihenfolge der Hotels oder Prüfung. Links je Objekt pflegst du in der Detailansicht (Reiter Stammdaten → Partnerlinks). Ohne Partnerkennung bzw. Deeplink-Vorlage sind es normale Links ohne Provision.</p>
<% if (flash) { %><div class="flash" style="border-color:var(--ok)"><%= flash %></div><% } %>
<% if (error) { %><div class="errors"><%= error %></div><% } %>

<h2>Klicks <small class="muted">letzte <%= days %> Tage · <% [7, 30, 90, 365].forEach(function (d) { %><a href="/admin/partner?tage=<%= d %>" class="<%= d === days ? 'on' : '' %>"><%= d %></a> <% }) %></small></h2>
<div class="table-scroll"><table>
  <tr><th>Programm</th><th>Eigene Links</th><th>Klicks eigene Links</th><th>Klicks Suchlinks</th></tr>
  <% stats.byProgram.forEach(function (p) { %><tr><td><%= p.name %></td><td><%= p.links %></td><td><strong><%= p.clicks %></strong></td><td><%= p.auto_search || p.search_clicks ? p.search_clicks : '–' %></td></tr><% }) %>
</table></div>
<% if (stats.top.length) { %>
  <details style="margin:8px 0 20px"><summary>Meistgeklickte Links</summary>
    <div class="table-scroll"><table><tr><th>Objekt</th><th>Programm</th><th>Art</th><th>Klicks</th></tr>
      <% stats.top.forEach(function (t) { %><tr><td><%= t.name %></td><td><%= t.program %></td><td><%= t.kind === 'reviews' ? 'Bewertungen' : 'Preise' %></td><td><%= t.clicks %></td></tr><% }) %>
    </table></div>
  </details>
<% } %>

<h2>Programme</h2>
<% programs.forEach(function (p) { var params = Object.keys(p.link_params || {}).map(function (k) { return k + '=' + p.link_params[k]; }).join('\n'); %>
  <section class="card" style="margin-bottom:12px" id="p-<%= p.code %>">
    <h3 style="margin-top:0"><span class="muted"><%= p.sort_order %> ·</span> <%= p.name %>
      <span class="badge <%= p.status === 'active' ? 'good' : '' %>"><%= p.status === 'active' ? 'aktiv' : 'inaktiv' %></span>
      <span class="badge <%= monetized(p) ? 'good' : 'warn' %>"><%= monetized(p) ? 'mit Partnerkennung' : 'ohne Partnerkennung' %></span></h3>
    <% if (p.notes) { %><p class="muted" style="margin-top:0"><small><%= p.notes %></small></p><% } %>
    <form method="post" action="/admin/partner/<%= p.id %>">
      <div class="form-row">
        <div><label>Anzeigename</label><input name="name" type="text" value="<%= p.name %>"></div>
        <div><label>Status</label><select name="status"><option value="active" <%= p.status === 'active' ? 'selected' : '' %>>aktiv (auf Profilseiten sichtbar)</option><option value="inactive" <%= p.status !== 'active' ? 'selected' : '' %>>inaktiv</option></select></div>
      </div>
      <div class="form-row">
        <div><label>Partnerkennung als Parameter <small class="muted">je Zeile name=wert, z. B. aid=1234567</small></label><textarea name="link_params" rows="2"><%= params %></textarea></div>
        <div><label>oder Deeplink-Vorlage eines Netzwerks <small class="muted">{url_enc} = Zieladresse, {slug} = Objekt (z. B. CJ: https://www.tkqlhce.com/click-PID-AID?url={url_enc}&amp;sid={slug})</small></label><input name="link_template" type="text" value="<%= p.link_template || '' %>"></div>
      </div>
      <div class="form-row">
        <div><label>Beschriftung Preise</label><input name="label_booking" type="text" value="<%= p.label_booking %>"></div>
        <div><label>Beschriftung Bewertungen</label><input name="label_reviews" type="text" value="<%= p.label_reviews %>"></div>
      </div>
      <div class="form-row">
        <div><label>Reihenfolge <small class="muted">kleiner = weiter vorn</small></label><input name="sort_order" type="number" min="0" max="999" value="<%= p.sort_order %>"></div>
        <div><label>Erlaubte Ziel-Domains <small class="muted">leer = beliebige https-Adresse</small></label><input name="domains" type="text" value="<%= p.domains.join(', ') %>"></div>
      </div>
      <div class="form-row">
        <div><label>Such-Adresse beim Anbieter <small class="muted">mit {q} = Name + Ort</small></label><input name="search_url" type="text" value="<%= p.search_url || '' %>" placeholder="https://…?q={q}"></div>
        <div><label>Für Objekte ohne eigenen Link</label><select name="auto_search">
          <option value="" <%= !p.auto_search ? 'selected' : '' %>>nur eigene Links je Objekt</option>
          <option value="booking" <%= p.auto_search === 'booking' ? 'selected' : '' %>>Suchseite als Preis-Link</option>
          <option value="reviews" <%= p.auto_search === 'reviews' ? 'selected' : '' %>>Suchseite als Bewertungs-Link</option>
        </select></div>
      </div>
      <div class="form-row">
        <div><label class="inline" style="margin-top:8px"><input type="checkbox" name="direct_link" <%= p.direct_link ? 'checked' : '' %>> <span>Direkt verlinken <small class="muted">– Link zeigt sichtbar auf den Anbieter bzw. das Netzwerk statt über unsere Weiterleitung (für Programme, die verkürzte/verdeckte Links verbieten, z. B. Expedia); gezählt wird trotzdem</small></span></label></div>
        <div><label>Markenhinweis <small class="muted">erscheint unter dem Kasten, wenn der Anbieter verlinkt ist</small></label><input name="trademark_notice" type="text" maxlength="300" value="<%= p.trademark_notice || '' %>"></div>
      </div>
      <label>Notiz</label><textarea name="notes" rows="2"><%= p.notes || '' %></textarea>
      <p style="margin-bottom:0"><button class="btn small" type="submit">Speichern</button></p>
    </form>
  </section>
<% }) %>
<section class="card">
  <h3 style="margin-top:0">Weiteres Programm anlegen</h3>
  <form method="post" action="/admin/partner/neu" class="form-row" style="align-items:end">
    <div><label>Name</label><input name="name" type="text" required placeholder="z. B. Hotels.com"></div>
    <div><label>Ziel-Domains</label><input name="domains" type="text" required placeholder="hotels.com"></div>
    <div><button class="btn small" type="submit">Anlegen</button></div>
  </form>
  <p class="muted" style="margin-bottom:0"><small>Neue Programme starten inaktiv. Danach Kennung bzw. Deeplink-Vorlage eintragen, Reihenfolge setzen und aktivieren.</small></p>
</section>
<%- include('../partials/admin-foot') %>
