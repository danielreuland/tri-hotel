<%- include('../partials/admin-head') %>
<h1>Camp-Anfragen</h1>
<p class="muted">Anfragen von Interessenten an Camp-Anbieter – einzeln (Anbieterprofil, nur mit Vereinbarung) oder als Sammelanfrage an bis zu 5 Anbieter (auch ohne Vereinbarung, dann an deren Kontaktadresse und ohne Abrechnung). 7 Tage nach der Weitergabe fragen wir den Anbieter nach dem Ergebnis. Weiterleiten erst, wenn die E-Mail bestätigt ist; prüfen auf Spam und ernsthaftes Interesse. Die Mail an den Anbieter enthält alle Angaben, Antworten gehen direkt an den Interessenten.</p>
<% if (flash) { %><div class="flash" style="border-color:var(--ok)"><%= flash %></div><% } %>
<% if (error) { %><div class="errors"><%= error %></div><% } %>
<% if (!active.length) { %><div class="flash">Noch kein Anbieter mit aktivem Anfrageformular. Vereinbarung eintragen unter <a href="/admin/camps">Inhalte → Camps</a> → Anbieter → „Anfragen (Leads)“.</div><% } else { %>
  <p class="muted"><small>Aktiv: <% active.forEach(function (a, i) { %><%= i ? ' · ' : '' %><a href="/trainingscamp/anbieter/<%= a.slug %>#anfrage" target="_blank"><%= a.name %></a> (<%= a.lead_model === 'per_lead' ? Number(a.lead_fee).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' }) + ' je Anfrage' : a.lead_model === 'commission' ? (a.lead_commission || '?') + ' % Provision' : 'ohne Vergütung' %>)<% }) %></small></p>
<% } %>
<div class="pill-row">
  <a class="badge <%= filter === 'offen' ? 'good' : '' %>" href="?status=offen">offen (<%= (counts.received || 0) + (counts.confirmed || 0) %>)</a>
  <a class="badge <%= filter === 'forwarded' ? 'good' : '' %>" href="?status=forwarded">weitergeleitet (<%= counts.forwarded || 0 %>)</a>
  <a class="badge <%= filter === 'rejected' ? 'good' : '' %>" href="?status=rejected">abgelehnt (<%= counts.rejected || 0 %>)</a>
  <a class="badge <%= filter === 'alle' ? 'good' : '' %>" href="?status=alle">alle</a>
</div>
<% if (!rows.length) { %><p class="card">Keine Anfragen in dieser Ansicht.</p><% } %>
<% var seenReq = {}; rows.forEach(function (l) { var to = l.lead_active && l.lead_email ? l.lead_email : (l.provider_contact_email || l.lead_email); var firstOfReq = l.request_id && !seenReq[l.request_id]; if (l.request_id) seenReq[l.request_id] = true; %>
  <article class="card" id="l-<%= l.id %>" style="margin-bottom:12px">
    <p style="margin-top:0"><span class="badge <%= l.status === 'forwarded' ? 'good' : l.status === 'rejected' ? 'bad' : 'warn' %>"><%= STATUS[l.status] %></span>
      <% if (l.request_id) { %><span class="badge accent" title="Sammelanfrage">Sammelanfrage · <%= l.req_providers %> Empfänger<%= l.req_kind === 'group' ? ' · Verein' : '' %></span><% } %>
      <% if (l.to_entity) { %><span class="badge good">Hotel direkt</span><% } else { %><span class="badge <%= l.lead_active ? 'good' : '' %>"><%= l.lead_active ? 'Partner' : 'ohne Vereinbarung' %></span><% } %>
      <strong><%= l.provider_name %></strong> · <%= l.name || 'anonymisiert' %> <small class="muted">· <%= l.email || '' %><%= l.phone ? ' · ' + l.phone : '' %> · eingegangen <%= new Date(l.created_at).toLocaleString('de-DE') %><%= l.verified_by ? ' · ohne E-Mail-Bestätigung freigeschaltet' : '' %></small></p>
    <p style="margin:0"><%= l.period_month ? new Date(l.period_month).toLocaleDateString('de-DE', { month: 'long', year: 'numeric', timeZone: 'UTC' }) : '' %><%= l.period_note ? ' – ' + l.period_note : '' %> · <%= l.persons %> Person(en)<%= l.level ? ' · ' + LEVELS[l.level] : '' %><%= l.entity_name || l.hotel_text ? ' · Hotel: ' + (l.entity_name || l.hotel_text) : '' %><%= l.req_club ? ' · ' + l.req_club : '' %><%= l.req_double || l.req_single ? ' · ' + [l.req_double ? l.req_double + ' DZ' : '', l.req_single ? l.req_single + ' EZ' : ''].filter(Boolean).join(', ') : '' %></p>
    <% if (l.message) { %><p style="white-space:pre-line;margin:6px 0"><%= l.message %></p><% } %>
    <% if (l.status === 'forwarded') { %><p class="muted" style="margin:6px 0 0"><small>Weitergeleitet am <%= new Date(l.forwarded_at).toLocaleString('de-DE') %> an <%= l.recipient || l.lead_email || 'Anbieter' %> · <%= l.partner_at_forward === false ? 'ohne Vereinbarung (keine Abrechnung)' : 'abgerechnet als ' + (MODELS[l.billed_model] || '–') %><%= l.billed_fee !== null ? ' (' + Number(l.billed_fee).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' }) + ')' : '' %></small></p><% } %>
    <% if (l.status === 'forwarded') { %><p class="muted" style="margin:4px 0 0"><small>Rückmeldung: <%= l.outcome ? OUTCOMES[l.outcome] + ' (' + new Date(l.outcome_at).toLocaleDateString('de-DE') + ')' : l.followup_sent_at ? 'Nachfrage gesendet am ' + new Date(l.followup_sent_at).toLocaleDateString('de-DE') + ', noch keine Antwort' : 'Nachfrage folgt 7 Tage nach der Weitergabe' %></small></p><% } %>
    <% if (l.rejection_reason) { %><p class="muted" style="margin:6px 0 0"><small>Grund: <%= l.rejection_reason %></small></p><% } %>
    <% if (['received', 'confirmed'].includes(l.status)) { %>
      <div class="filters" style="margin:10px 0 0">
        <% if (l.status === 'received') { %><form method="post" action="/admin/camp-anfragen/<%= l.id %>/aktion"><input type="hidden" name="status" value="<%= filter %>"><button class="btn small secondary" name="action" value="verify">Ohne Bestätigung freischalten</button></form><% } %>
        <% if (l.status === 'confirmed' && firstOfReq && l.req_providers > 1) { %><form method="post" action="/admin/camp-anfragen/<%= l.id %>/aktion" data-confirm="Sammelanfrage jetzt an alle <%= l.req_providers %> gewählten Empfänger weiterleiten?"><input type="hidden" name="status" value="<%= filter %>"><button class="btn small" name="action" value="forward_all">An alle <%= l.req_providers %> Empfänger weiterleiten</button></form><% } %>
        <% if (l.status === 'confirmed') { %><form method="post" action="/admin/camp-anfragen/<%= l.id %>/aktion" data-confirm="Anfrage jetzt an <%= l.provider_name %> (<%= to || 'keine Adresse!' %>) weiterleiten?"><input type="hidden" name="status" value="<%= filter %>"><button class="btn small <%= l.request_id ? 'secondary' : '' %>" name="action" value="forward" <%= to ? '' : (l.to_entity ? 'disabled title="Keine Adresse – Kontakt-E-Mail in den Stammdaten des Hotels eintragen"' : 'disabled title="Keine Adresse – Kontakt-E-Mail im Anbieterprofil eintragen"') %>>An <%= l.provider_name %> weiterleiten</button></form><% } %>
        <form method="post" action="/admin/camp-anfragen/<%= l.id %>/aktion" class="filters" style="margin:0"><input type="hidden" name="status" value="<%= filter %>"><input name="reason" type="text" placeholder="Grund (intern), z. B. Spam" style="max-width:220px"><button class="btn small secondary" name="action" value="reject">Ablehnen</button></form>
      </div>
    <% } %>
  </article>
<% }) %>

<h2>Abrechnung</h2>
<p class="muted" style="margin-top:0"><small>Weitergeleitete Anfragen je Monat und Anbieter, zu den Konditionen bei der Weitergabe. Provisionen auf Buchungen meldet der Anbieter selbst.</small></p>
<% if (!billing.length) { %><p class="muted">Noch keine weitergeleiteten Anfragen.</p><% } else { %>
  <div class="table-scroll"><table>
    <tr><th>Monat</th><th>Anbieter</th><th>Modell</th><th>Anfragen</th><th>Betrag</th></tr>
    <% billing.forEach(function (b) { %><tr><td><%= new Date(b.month).toLocaleDateString('de-DE', { month: 'long', year: 'numeric', timeZone: 'UTC' }) %></td><td><%= b.provider %></td><td><%= MODELS[b.model] || '–' %></td><td><%= b.leads %></td><td><strong><%= Number(b.amount).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' }) %></strong></td></tr><% }) %>
  </table></div>
<% } %>
<%- include('../partials/admin-foot') %>
