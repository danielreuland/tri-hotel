<section id="vergleich" aria-labelledby="h-vergleich">
  <h2 id="h-vergleich">Ferienwohnung, Sporthotel oder organisiertes Camp – der Vergleich</h2>
  <div class="table-scroll">
  <table class="ratgeber-table">
    <thead><tr><th scope="col">Kriterium</th><th scope="col">Ferienwohnung (selbst organisiert)</th><th scope="col">Sporthotel (ohne Camp)</th><th scope="col">Organisiertes Camp</th></tr></thead>
    <tbody>
      <tr><th scope="row">Termine &amp; Ort</th><td>frei wählbar</td><td>frei wählbar</td><td>feste Termine (z. B. <%- S.tour %> 20.–27.03.2027)</td></tr>
      <tr><th scope="row">Schwimmbad</th><td>selten vorhanden, öffentliches Bad selbst suchen</td><td>je nach Hotel. Manche Camp-Hotels haben nur 25 m <span class="src">(<%- S.gtt %>)</span>, Resorts wie Club La Santa drei 50-m-Becken <span class="src">(<%- S.cls %>)</span></td><td>meist über das Hotel geregelt</td></tr>
      <tr><th scope="row">Radraum / Werkstatt</th><td>nicht garantiert, beim Vermieter erfragen</td><td>oft Radgarage</td><td>Radgarage oder nummeriertes Depot mit Werkstatt-Service <span class="src">(<%- S.tour %>)</span></td></tr>
      <tr><th scope="row">Verpflegung</th><td>selbst kochen, volle Kontrolle über Menge und Makros <span class="src">(<%- S.wahoo %>)</span></td><td>oft Halbpension, passt aber nicht immer zu Athleten</td><td>Halbpension, teils Picknick und Getränke unterwegs. Mittagessen manchmal nicht inklusive <span class="src">(<%- S.gtt %>)</span></td></tr>
      <tr><th scope="row">Coaching / Feedback</th><td>keins. Ein fester Ansprechpartner für tägliche Check-ins hilft <span class="src">(<%- S.wahoo %>)</span></td><td>keins</td><td>Coaching, geführte Ausfahrten in Leistungsgruppen <span class="src">(<%- S.tour %>)</span></td></tr>
      <tr><th scope="row">Struktur / Disziplin</th><td>ganz in der eigenen Verantwortung</td><td>eigene Verantwortung</td><td>fester Plan, der verhindert, dass man nur trainiert, „wenn es passt“ <span class="src">(<%- S.t220 %>)</span></td></tr>
      <tr><th scope="row">Haushalt / Ablenkung</th><td>Einkaufen, Kochen, Putzen</td><td>gering</td><td>gering, mehr Zeit für Training und Erholung <span class="src">(<%- S.rr %>)</span></td></tr>
      <tr><th scope="row">Privatsphäre / Gruppe</th><td>hoch, der Verein bleibt unter sich</td><td>mittel</td><td>gering, die Gruppe ist gemischt</td></tr>
      <tr><th scope="row">Kosten</th><td>in Gruppen oft günstiger pro Person (Einschätzung, nicht belegt), keine teuren Pauschalpreise <span class="src">(<%- S.hunt %>)</span></td><td>je nach Hotel</td><td>z. B. 885 £ p. P. für 7 Nächte mit Halbpension, ohne Flug (<%- S.gtt %>, 2026)</td></tr>
      <tr><th scope="row">Planungsaufwand</th><td>hoch (Bad, Routen, Leihrad, Auto)</td><td>mittel</td><td>gering. Flug, Transfer und Leihrad sind oft trotzdem nicht inklusive <span class="src">(<%- S.tour %>)</span></td></tr>
