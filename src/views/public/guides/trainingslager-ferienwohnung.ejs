        <% c.blocks.forEach(function (b) { %>
          <% if (b.type === 'ul') { %><ul><% b.items.forEach(function (it) { %><li><%- rich(it) %></li><% }) %></ul>
          <% } else if (b.type === 'h') { %><p><strong><%= b.text %></strong></p>
          <% } else { %><p><%- rich(b.text) %></p><% } %>
        <% }) %>
        <% if (c.checked_on) { %><p class="muted"><small>Stand: <%= dayLabel(c.checked_on) %></small></p><% } %>
