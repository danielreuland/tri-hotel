<%- include('../partials/head') %>
<%
  var title = content.hero_title || ranking.name;
  var hl = content.hero_highlight && title.indexOf(content.hero_highlight) >= 0 ? content.hero_highlight : null;
  var heroImg = siteMedia.slots.home_hero, ctaImg = siteMedia.slots.cta_band;
  function num(v, d) { return v === null || v === undefined ? '–' : Number(v).toLocaleString('de-DE', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 }); }
%>

<% var about = blocks.find(function (b) { return b.key === 'about'; }); var bands = blocks.filter(function (b) { return b.key !== 'about'; }); %>
<%# Kopfbereich: Claim, Kennzahlen (Bereich „Über die Seite“), Top-Objekt des Tages und darunter der Finder über die volle Breite %>
<section class="hero-band<%= heroImg ? ' has-photo' : '' %>" id="ueber">
  <% if (heroImg) { %>
    <img class="band-photo" <%- imgAttrs(heroImg) %> sizes="100vw" alt="" fetchpriority="high">
    <small class="photo-credit"><%= heroImg.credit %></small>
  <% } %>
  <div class="wrap hero-grid home-hero<%= heroTop ? '' : ' single' %>">
    <div class="hero-claim">
      <% if (content.hero_eyebrow) { %><p class="eyebrow"><%= content.hero_eyebrow %></p><% } %>
      <h1 class="hero-title">
        <% if (hl) { var i = title.indexOf(hl); %><%= title.slice(0, i) %><em><%= hl %></em><%= title.slice(i + hl.length) %><% } else { %><%= title %><% } %>
      </h1>
      <p class="hero-text"><%= content.hero_text || ranking.description || '' %></p>
      <% if (about) { %>
        <p class="hero-stats">
          <a href="<%= listHref %>"><strong><%= stats.entities %></strong> geprüfte <%= ranking.entity_label_pl %></a>
          <% if (regionGuide) { %><a href="/trainingsregionen"><strong><%= stats.regions %></strong> Trainingsregionen</a><% } %>
          <% if (campGuide) { %><a href="/trainingscamp#anbieter"><strong><%= stats.camps %></strong> Camp-Anbieter</a><% } %>
          <a href="<%= scorePath %>"><strong><%= stats.criteria %></strong> Kriterien im <%= ranking.score_name %></a>
          <a href="<%= scorePath %>" class="hero-neutral">Partner ändern weder Score noch Reihenfolge</a>
        </p>
      <% } %>
    </div>
    <% var FD = finder; %>
    <div class="hero-finder-cell">
      <form class="hero-finder" method="get" action="<%= listHref %>#ranking" role="search" aria-label="<%= ranking.entity_label_sg %>-Finder"
            data-finder data-count-url="/finder/treffer" data-noun="<%= ranking.entity_label_pl %>" data-noun-sg="<%= ranking.entity_label_sg %>">
        <div class="hf-line">
          <div class="hf-field hf-q"><label for="hf-q"><%= ranking.entity_label_sg %> oder Ort</label>
            <input id="hf-q" type="search" name="q" placeholder="z. B. Mallorca"></div>
          <div class="hf-field"><label for="hf-monat">Reisemonat</label>
            <select id="hf-monat" name="monat"><option value="">flexibel</option><% FD.MONTHS.forEach(function (m, i) { %><option value="<%= i + 1 %>"><%= m %></option><% }) %></select></div>
          <div class="hf-field"><label for="hf-wetter">Wetter im Monat</label>
            <select id="hf-wetter" name="wetter" title="Ø-Tageshöchstwert im gewählten Reisemonat (Open-Meteo)"><option value="">egal</option><% Object.keys(FD.WEATHER).forEach(function (k) { var w = FD.WEATHER[k]; %><option value="<%= k %>"><%= w.label %> (<%= w.hint %>)</option><% }) %></select></div>
          <details class="hf-more">
            <summary>Ausstattung<span class="hf-n" data-finder-n></span></summary>
            <div class="hf-pop">
              <% FD.groups.forEach(function (g) { %>
                <div class="hf-group"><span><%= g.label %></span>
                  <div class="chips"><% g.items.forEach(function (f) { %><label class="chip"><input type="checkbox" name="l" value="<%= f.code %>"> <span><%= f.label %></span></label><% }) %></div></div>
              <% }) %>
            </div>
          </details>
          <label class="chip hf-rain"><input type="checkbox" name="regen" value="1"> <span>wenig Regen</span></label>
          <button class="btn hf-go" type="submit" data-finder-submit><%= FD.total %> <%= ranking.entity_label_pl %> anzeigen</button>
        </div>
        <p class="hf-live" aria-live="polite" data-finder-live hidden></p>
      </form>
    </div>
    <% if (heroTop) { var HS = heroTop.slides; %>
      <div class="hero-pick-slider" data-hero-slider data-interval="5000" data-start="<%= heroTop.start %>"
           role="region" aria-roledescription="Karussell" aria-label="Top-<%= ranking.entity_label_pl %> ab <%= ranking.score_name %> <%= heroMinScore %>">
        <div class="hs-track">
          <% HS.forEach(function (hp, i) { var on = i === heroTop.start; %>
            <a class="score-card hero-pick<%= on ? ' is-active' : '' %>" href="<%= entityPath(hp) %>" data-slide
               role="group" aria-roledescription="Folie" aria-label="<%= i + 1 %> von <%= HS.length %>: <%= hp.name %>"<%- on ? '' : ' aria-hidden="true" tabindex="-1"' %>>
              <span class="hp-photo">
                <% if (hp.thumb) { %>
                  <img src="<%= hp.thumb.src %>" srcset="<%= hp.thumb.srcset %>" sizes="(max-width: 860px) 100vw, 460px" width="<%= hp.thumb.width %>" height="<%= hp.thumb.height %>"
                    alt="<%= hp.thumb.example ? '' : hp.name + (hp.city ? ', ' + hp.city : '') %>"<%- on ? ' fetchpriority="high"' : ' loading="lazy"' %><% if (hp.thumb.focal) { %> style="object-position:<%= String(hp.thumb.focal).replace(/[^0-9% .a-z-]/gi, '') %>"<% } %>>
                  <% if (hp.thumb.example) { %><span class="thumb-badge" title="Symbolbild der Region <%= hp.thumb.example %>, kein Foto dieses <%= ranking.entity_label_sg %>s">Symbolbild</span><% } %>
                  <small class="thumb-credit"><%= hp.thumb.credit %></small>
                <% } else { %><span class="thumb-empty" aria-hidden="true"><%= String(hp.name || '').trim().charAt(0).toUpperCase() %></span><% } %>
              </span>
              <span class="hp-body">
                <span class="eyebrow">Top-<%= ranking.entity_label_pl %> · Platz <%= hp.rank %></span>
                <span class="hp-head">
                  <span><span class="hp-name"><%= hp.name %></span><small><%= hp.city %><%= hp.country ? ', ' + hp.country : '' %> · <%= hp.label %></small></span>
                  <span class="score"><%= hp.score %></span>
                </span>
                <% if (hp.features && hp.features.length) { %><span class="hp-feats"><%= hp.features.map(function (f) { return f.label; }).join(' · ') %></span><% } %>
                <span class="hp-link">Zum <%= ranking.entity_label_sg %> und allen Fakten →</span>
              </span>
            </a>
          <% }) %>
        </div>
        <div class="hs-controls">
          <% if (HS.length > 1) { %>
            <button type="button" class="hs-pause" data-slider-pause aria-label="Wechsel anhalten" hidden>❚❚</button>
            <span class="hs-dots"><% HS.forEach(function (hp, i) { %><button type="button" class="hs-dot<%= i === heroTop.start ? ' is-active' : '' %>" data-slider-dot="<%= i %>" aria-label="<%= hp.name %> zeigen"<%- i === heroTop.start ? ' aria-current="true"' : '' %>></button><% }) %></span>
          <% } %>
          <small class="hp-note">Alle <%= HS.length %> <%= ranking.entity_label_pl %> ab <%= ranking.score_name %> <%= heroMinScore %> im Wechsel, nach Score sortiert, unabhängig von Partnerschaften.</small>
        </div>
      </div>
    <% } %>
  </div>
</section>

<% bands.forEach(function (b, idx) { var alt = idx % 2 === 1; %>
<section class="home-band<%= alt ? ' alt' : '' %>" id="<%= { entities: 'bestenliste', camps: 'camps', regions: 'regionen' }[b.key] %>">
  <div class="wrap home-band-grid">

  <% if (b.key === 'entities') { %>
    <div class="home-band-text">
      <p class="eyebrow"><%= ranking.score_name %>-Ranking</p>
      <h2>Die besten <%= ranking.entity_label_pl %></h2>
      <p>Sortiert nur nach <%= ranking.score_name %>. Im Ranking findest du alle <%= b.count %> geprüften <%= ranking.entity_label_pl %> mit Filtern nach Land, Reisemonat und Leistungen.</p>
      <p><a class="btn" href="<%= listHref %>">Alle <%= ranking.entity_label_pl %> im Ranking</a></p>
      <% if (b.top.length) { %>
        <ol class="home-mini-list">
          <% b.top.slice(0, 3).forEach(function (e) { %>
            <li><a href="<%= entityPath(e) %>"><span class="pos"><%= e.rank %></span><span class="nm"><%= e.name %><small><%= e.city %></small></span><span class="score"><%= e.score %></span></a></li>
          <% }) %>
        </ol>
      <% } %>
    </div>
    <div class="home-band-side">
      <% if (b.featured) { var f = b.featured; %>
        <a class="score-card home-feature" href="<%= entityPath(f.entity) %>">
          <p class="caption"><%= b.reason === 'editorial' ? 'Tipp der Redaktion · Platz ' + f.entity.rank : 'Platz 1 im Detail' %> · so setzt sich der <%= ranking.score_name %> zusammen</p>
          <div class="head">
            <div>
              <div class="name"><%= f.entity.name %></div>
              <small><%= f.entity.city %><%= f.entity.country ? ', ' + f.entity.country : '' %> · <%= f.label %></small>
            </div>
            <span class="score big"><%= f.score %></span>
          </div>
          <ul class="bars">
            <% f.bars.forEach(function (bar) { var pct = bar.max ? Math.round(100 * bar.points / bar.max) : 0; %>
              <li><span><%= bar.label %></span><span class="track"><span class="fill" style="width:<%= pct %>%"></span></span><span class="val"><%= bar.points %>/<%= bar.max %></span></li>
            <% }) %>
          </ul>
        </a>
      <% } %>
    </div>

  <% } else if (b.key === 'camps') { var p = b.featured; var price = (p.prices || [])[0]; %>
    <div class="home-band-text">
      <p class="eyebrow">Trainingscamps</p>
      <h2>Camp-Anbieter</h2>
      <p>Organisierte Trainingslager mit Coach, als Gruppenreise oder im Sportresort. Alle <%= b.count %> Anbieter stehen neutral und alphabetisch in der Übersicht, mit Leistungen, Zielen und Preisen.</p>
      <p class="btn-row"><a class="btn" href="/trainingscamp#anbieter">Alle Camp-Anbieter</a> <a class="btn secondary" href="/trainingscamp/angebote">Camp-Angebote anfragen</a></p>
      <p class="muted" style="margin-top:-6px"><small>Für Einzelne, Freunde und Vereine: einmal Wünsche angeben, passende Anbieter antworten direkt.</small></p>
      <div class="chips">
        <% b.others.slice(0, 8).forEach(function (o) { %><a class="chip" href="/trainingscamp/anbieter/<%= o.slug %>"><%= o.name %></a><% }) %>
      </div>
      <p class="muted"><small>Du bietest Trainingscamps an? <a href="/trainingscamp/fuer-anbieter">Eintrag anfragen</a></small></p>
    </div>
    <div class="home-band-side">
      <article class="card home-feature camp-feature">
        <p class="caption"><%= b.reason === 'editorial' ? 'Tipp der Redaktion' : 'Heute vorgestellt · wechselt täglich' %></p>
        <header>
          <span class="badge"><%= b.MODELS[p.model] %></span>
          <% if (p.partner) { %><span class="badge ad-badge" title="Mit diesem Anbieter besteht eine Vereinbarung. Auf Auswahl und Darstellung hat das keinen Einfluss.">Anzeige · Partner</span><% } %>
        </header>
        <h3><a href="/trainingscamp/anbieter/<%= p.slug %>"><%= p.name %></a></h3>
        <p class="muted"><%= (p.destinations || []).join(' · ') || 'Ziele nicht angegeben' %></p>
        <% if (p.summary) { %><p class="home-summary"><%= p.summary %></p><% } %>
        <% if (price) { %><p><strong><%= price.price %></strong> <span class="muted">· <%= price.label %>, <%= price.duration %></span></p><% } %>
        <p><a href="/trainingscamp/anbieter/<%= p.slug %>">Profil &amp; Hotels →</a></p>
      </article>
    </div>

  <% } else if (b.key === 'regions') { var r = b.featured; var c = b.avg; var photo = siteMedia.regions[r.region.id]; var sm = b.season.months; %>
    <div class="home-band-text">
      <p class="eyebrow">Trainingsregionen</p>
      <h2>Wohin im <%= b.season.label %>?</h2>
      <p><strong><%= b.season.note %>.</strong> Klima, Wassertemperatur, Wind und Radrevier aller Regionen im Überblick – sortiert nach Eignung im <%= b.season.label %> und direkt vergleichbar.</p>
      <p><a class="btn" href="/trainingsregionen?monat=<%= b.season.key %>">Alle Regionen im <%= b.season.label %></a></p>
      <div class="chips">
        <% b.others.forEach(function (o) { %><a class="chip" href="/region/<%= o.slug %>"><%= o.name %></a><% }) %>
      </div>
    </div>
    <div class="home-band-side">
      <article class="card home-feature region-feature">
        <% if (photo) { %>
          <a class="rg-photo" href="/region/<%= r.slug %>" tabindex="-1" aria-hidden="true">
            <img <%- imgAttrs(photo) %> sizes="(max-width: 860px) 100vw, 520px" alt="" loading="lazy">
            <small class="photo-credit"><%= photo.credit %></small>
          </a>
        <% } %>
        <p class="caption"><%= b.reason === 'editorial' ? 'Tipp der Redaktion' : (b.fitMonths === sm.length ? 'Den ganzen ' + b.season.label + ' beste Reisezeit' : b.fitMonths ? 'Im ' + b.season.label + ' vorn' : 'Im ' + b.season.label + ' am besten geeignet') %></p>
        <h3><a href="/region/<%= r.slug %>"><%= r.name %></a> <small class="muted"><%= r.countryName %></small></h3>
        <dl class="region-stats">
          <div><dt>Ø max</dt><dd><%= num(c.avg_high_c) %> °C</dd></div>
          <div><dt>Regentage</dt><dd><%= num(c.rain_days) %>/Monat</dd></div>
          <div><dt>Sonne</dt><dd><%= num(c.sunshine_h) %> h</dd></div>
          <div><dt>Wasser</dt><dd><%= c.sea_c === null || c.sea_c === undefined ? 'Binnenland' : num(c.sea_c) + ' °C' %></dd></div>
          <% if (r.bike) { %><div><dt>Radrevier</dt><dd><%= num(r.bike.score, 1) %>/6</dd></div><% } %>
        </dl>
        <p class="muted" style="margin-top:-4px"><small>Mittel <%= sm.map(function (m) { return MONTHS[m - 1]; }).join(', ') %></small></p>
        <ol class="month-strip" aria-label="Beste Reisezeit">
          <% r.climate.forEach(function (m) { %><li class="<%= r.bestMonths.indexOf(Number(m.month)) >= 0 ? 'best' : '' %><%= sm.indexOf(Number(m.month)) >= 0 ? ' cur' : '' %>" title="<%= MONTHS[m.month - 1] %>"><span><%= MONTHS[m.month - 1].slice(0, 1) %></span></li><% }) %>
        </ol>
        <p class="muted"><small><%= r.hotels ? r.hotels + ' ' + (r.hotels === 1 ? ranking.entity_label_sg : ranking.entity_label_pl) + (r.topScore !== null ? ' · bester ' + ranking.score_name + ' ' + r.topScore : '') : 'Noch kein geprüftes ' + ranking.entity_label_sg %></small></p>
      </article>
    </div>
  <% } %>

  </div>
</section>
<% }) %>

<section class="cta-band<%= ctaImg ? ' has-photo' : '' %>">
  <% if (ctaImg) { %>
    <img class="band-photo" <%- imgAttrs(ctaImg) %> sizes="100vw" alt="" loading="lazy">
    <small class="photo-credit"><%= ctaImg.credit %></small>
  <% } %>
  <div class="wrap">
    <div>
      <h2><%= content.cta_title || (ranking.entity_label_sg + ' hinzufügen') %></h2>
      <p><%= content.cta_text || '' %></p>
    </div>
    <a class="btn large cta" href="/<%= ranking.entity_type %>-hinzufuegen"><%= ranking.entity_label_sg %> hinzufügen</a>
  </div>
</section>

<%- include('../partials/foot') %>
