<%- include('../partials/head') %>

<nav class="crumbs" aria-label="Brotkrumen">
  <% crumbs.forEach(function (c, i) { %><% if (i < crumbs.length - 1) { %><a href="<%= c.url.replace(siteUrl, '') || '/' %>"><%= c.name %></a> › <% } else { %><span><%= c.name %></span><% } %><% }) %>
</nav>

<div class="grid grid-2" style="align-items:center">
  <div>
    <h1><%= entity.name %></h1>
    <p class="muted"><%= entity.city %><%= entity.country ? ', ' + entity.country : '' %>
      <% if (entity.website) { %> · <a href="<%= entity.website %>" rel="nofollow noopener" target="_blank" data-goal="Hotel-Website">Website</a><% } %></p>
  </div>
  <div style="display:flex;gap:16px;align-items:center;justify-content:flex-end;flex-wrap:wrap">
    <div>
      <div class="muted"><%= ranking.score_name %></div>
      <% if (result.score !== null) { %>
        <div><strong><%= result.label %></strong></div>
        <% if (result.provisional) { %><span class="badge warn">vorläufig</span><% } %>
        <% if (!eligible) { %><span class="badge">Profil unvollständig</span><% } %>
      <% } %>
    </div>
    <span class="score big <%= result.score === null ? 'none' : '' %>"><%= result.score === null ? '–' : result.score %></span>
  </div>
</div>

<div class="card" style="margin-top:16px">
  <p style="margin:0">
    Fakten-Score <strong><%= result.factScore === null ? '–' : Math.round(result.factScore) %></strong> ·
    Vollständigkeit <strong><%= Math.round(result.completeness) %> %</strong>
    <small>(ins Ranking ab <%= minCompleteness %> %)</small> ·
    <% if (athleteUsed) { %>Athleten-Score <strong><%= Math.round(result.athleteScore) %></strong> <small>(aus <%= reviewList.length %> Bewertungen)</small><% } else if (reviewList.length) { %><a href="#bewertungen">★ <%= String(reviewAvg === null ? '' : reviewAvg.toFixed(1)).replace('.', ',') %> aus <%= reviewList.length %> <%= reviewList.length === 1 ? 'Bewertung' : 'Bewertungen' %></a> <small>(nicht im <%= ranking.score_name %>)</small><% } else { %><a href="#bewertungen">Noch keine Bewertungen</a><% } %>
  </p>
  <% if (result.provisional) { %>
    <p class="muted" style="margin:.5em 0 0">Vorläufig: Der Score beruht bisher nur auf geprüften Fakten. Sobald genug Bewertungen vorliegen, fließen sie ein.</p>
  <% } %>
</div>

<% var galleryCount = images.length + guestPhotos.length; %>
<% if (galleryCount || regionExamples.length) { %>
  <section class="gallery-wrap" style="margin-top:16px" aria-label="Fotos">
    <% if (!galleryCount) { %>
      <p class="gallery-note"><strong>Beispielbilder der Region <%= galleryRegion.name %></strong> – noch keine Fotos dieses <%= ranking.entity_label_sg %>s.<% if (reviewCfg.enabled) { %> Warst du dort? <a href="/<%= ranking.entity_type %>/<%= entity.slug %>/bewerten">Teile deine Fotos mit einer Bewertung →</a><% } %></p>
    <% } %>
    <% var shown = Math.min(images.length, 5) + Math.min(guestPhotos.length, Math.max(0, 5 - images.length)) + regionExamples.length; %>
    <div class="gallery" data-n="<%= Math.min(shown, 5) %>">
      <% images.slice(0, 5).forEach(function (img) { %>
        <figure>
          <% if (img.variants && img.variants.length) { %><img <%- entityImgAttrs(img) %> sizes="(max-width: 700px) 100vw, 50vw" alt="<%= entity.name %>" loading="lazy">
          <% } else { %><img src="/media/<%= img.id %>" alt="<%= entity.name %>" loading="lazy"><% } %>
          <figcaption>© <%= String(img.credit).replace(/^\s*(©|\(c\))\s*/i, "") %><%= img.license ? ' · ' + img.license : '' %></figcaption>
        </figure>
      <% }) %>
      <% guestPhotos.slice(0, Math.max(0, 5 - images.length)).forEach(function (p) { var v = p.variants; var mid = v.includes(1280) ? 1280 : v[v.length - 1]; %>
        <figure>
          <a href="/media/review/<%= p.id %>-<%= v[v.length - 1] %>.webp" target="_blank" rel="noopener"><img src="/media/review/<%= p.id %>-<%= mid %>.webp" srcset="<%= v.map(function (w) { return '/media/review/' + p.id + '-' + w + '.webp ' + w + 'w'; }).join(', ') %>" sizes="(max-width: 700px) 100vw, 50vw" width="<%= mid %>" height="<%= Math.round(p.height * mid / p.width) %>" alt="Gastfoto aus <%= entity.name %>" loading="lazy"></a>
          <figcaption>Gastfoto: <%= p.author %> · <%= new Date(p.stay_month).toLocaleDateString('de-DE', { month: 'long', year: 'numeric' }) %></figcaption>
        </figure>
      <% }) %>
      <% regionExamples.forEach(function (m) { %>
        <figure class="example">
          <img <%- imgAttrs(m) %> sizes="(max-width: 700px) 100vw, 50vw" alt="<%= m.alt %>" loading="lazy">
          <figcaption><span class="badge">Beispiel Region</span> <%= m.credit %></figcaption>
        </figure>
      <% }) %>
    </div>
    <% if (guestPhotos.length > Math.max(0, 5 - images.length)) { %><p class="muted"><small><a href="#bewertungen">Weitere Gastfotos bei den Bewertungen</a></small></p><% } %>
  </section>
<% } %>

<% if (textBlocks.length) { %>
  <section class="entity-text" style="margin-top:20px">
    <h2 style="margin-top:0">Unsere Einschätzung</h2>
    <% textBlocks.forEach(function (b) { %>
      <% if (b.type === 'h') { %><h3><%= b.text %></h3>
      <% } else if (b.type === 'ul') { %><ul><% b.items.forEach(function (i) { %><li><%= i %></li><% }) %></ul>
      <% } else { %><p><%= b.text %></p><% } %>
    <% }) %>
    <p class="muted"><small>Redaktionstext auf Basis der geprüften Fakten unten<%= textDate ? ', Stand ' + new Date(textDate).toLocaleDateString('de-DE') : '' %>.</small></p>
  </section>
<% } %>

<% var gEmbed = googleMapsEmbedUrl(entity); %>
<% if (!gEmbed) { %><p class="other-opinions muted"><small>Allgemeine Gästemeinungen (nicht Teil des <%= ranking.score_name %>): <a href="<%= googleMapsUrl(entity) %>" target="_blank" rel="nofollow noopener">Bewertungen bei Google ansehen ↗</a></small></p><% } %>

<% if (campProviders.length) { %>
  <section class="camp-box card" style="margin-top:20px">
    <h2 style="margin-top:0">Trainingscamps in diesem <%= ranking.entity_label_sg %></h2>
    <p class="muted" style="margin-top:0">Diese Anbieter führen hier laut eigener Website Camps durch:</p>
    <ul class="chips">
      <% campProviders.forEach(function (c) { %><li style="list-style:none"><a class="chip" href="/trainingscamp/anbieter/<%= c.slug %>"><%= c.name %> <span class="muted">· <%= CAMP_MODELS[c.model] %></span></a><% if (c.lead_active) { %> <a class="chip chip-cta" href="/trainingscamp/anbieter/<%= c.slug %>?hotel=<%= entity.id %>#anfrage">Camp hier anfragen</a><% } %></li><% }) %>
    </ul>
    <div class="filters" style="margin:12px 0 0">
      <a class="btn cta" href="/trainingscamp/angebote?hotel=<%= entity.slug %>&amp;gruppe=1" data-goal="Vereinscamp-Anfrage">Vereinscamp in diesem <%= ranking.entity_label_sg %> anfragen</a>
      <a class="btn secondary" href="/trainingscamp/angebote?hotel=<%= entity.slug %>">Mit Freunden anfragen</a>
    </div>
    <p class="muted" style="margin:8px 0 0"><small>Eine Anfrage, Angebote von bis zu fünf passenden Anbietern – kostenlos und unverbindlich. <a href="/trainingscamp#anbieter">Alle Camp-Anbieter vergleichen →</a></small></p>
  </section>
<% } %>

<% if (featureGroups.length) { %>
  <section style="margin-top:20px">
    <h2 style="margin-top:0">Leistungen auf einen Blick</h2>
    <div class="features">
      <% featureGroups.forEach(function (g) { %>
        <div class="group"><h3><%= g.label %></h3><ul><% g.items.forEach(function (f) { %><li><%= f.label %></li><% }) %></ul></div>
      <% }) %>
    </div>
    <p class="muted"><small>Einheitliche Bezeichnungen für alle <%= ranking.entity_label_pl %>. Abgeleitet aus den geprüften Fakten unten oder von uns bzw. vom <%= ranking.entity_label_sg %> bestätigt.</small></p>
  </section>
<% } %>



<div class="grid grid-2 grid-content" style="margin-top:8px">
  <section>
    <div class="facts-head">
      <h2>Fakten</h2>
      <button type="button" class="linklike" data-toggle-all="facts" data-open-text="alle zuklappen" data-closed-text="alle aufklappen">alle aufklappen</button>
    </div>
    <div class="facts-groups" id="facts">
    <% groups.forEach(function (g) { var unknown = g.items.filter(function (it) { return it.value === null }).length; var pct = g.max ? Math.round(100 * g.points / g.max) : 0; %>
      <details class="facts-cat">
        <summary>
          <span class="cat"><%= g.label %></span>
          <span class="bar" aria-hidden="true"><span style="width:<%= pct %>%"></span></span>
          <span class="pts"><%= g.points %> / <%= g.max %></span>
          <small class="sub"><%= g.items.length %> <%= g.items.length === 1 ? 'Kriterium' : 'Kriterien' %><%= unknown ? ' · ' + unknown + ' unbekannt' : '' %></small>
        </summary>
        <% g.items.forEach(function (it) { %>
          <div class="fact">
            <span><%= it.label %></span>
            <span class="val <%= it.value === null ? 'unknown' : '' %>"><%= it.value === null ? 'unbekannt' : it.value %><% if (it.points !== null) { %> <small>(<%= it.points %>)</small><% } else if (it.imputed !== null && it.imputed !== undefined) { %> <small title="Unbekannt: zählt mit dem Durchschnitt aller geprüften <%= ranking.entity_label_pl %>">(Ø <%= String(Math.round(it.imputed * 10) / 10).replace('.', ',') %>)</small><% } %></span>
            <% if (it.areaInfo && it.areaInfo.subscores) { var ai = it.areaInfo; var AL = ai.labels || {}; var AM = ai.max || {}; %>
              <span class="src">Gebiet <%= ai.areaName %>: <% ['network', 'traffic', 'terrain', 'routes'].forEach(function (k, i) { if (ai.subscores[k] === null || ai.subscores[k] === undefined) return; %><%= i ? ' · ' : '' %><%= AL[k] || k %> <%= String(ai.subscores[k]).replace('.', ',') %>/<%= AM[k] %><% }) %><%= ai.adjust ? ' · am Hotel ' + ai.adjust : '' %> <small>(OpenStreetMap, Höhendaten)</small></span>
            <% } %>
            <% if (it.linkSource === 'camp_providers' && campProviders.length) { %>
              <span class="src">Camps von <% campProviders.forEach(function (c, i) { %><%= i ? ', ' : '' %><a href="/trainingscamp/anbieter/<%= c.slug %>"><%= c.name %></a><% }) %></span>
            <% } %>
            <% if (it.source || it.disputed) { %>
              <span class="src">
                <%= it.source || '' %>
                <% if (it.evidenceUrl) { %> · <a href="<%= it.evidenceUrl %>" rel="nofollow noopener" target="_blank">Fundstelle</a><% } %>
                <% if (it.disputed) { %> · <span class="badge bad">strittig</span><% } %>
              </span>
            <% } %>
          </div>
        <% }) %>
      </details>
    <% }) %>
    </div>
    <p class="muted">Fehlt etwas oder stimmt ein Wert nicht? Schreib uns – wir prüfen jede Rückmeldung.</p>
  </section>

  <section>
    <% if (partnerGroups.length) { var anyAd = partnerGroups.some(function (g) { return g.monetized; }); %>
      <h2 id="partner">Preise und Bewertungen</h2>
      <div class="ad partner-box">
        <% if (anyAd) { %><div class="ad-label">Anzeige</div><% } %>
        <ul class="partner-links">
          <% partnerGroups.forEach(function (g) { %>
            <li><strong><%= g.name %></strong>
              <% if (g.kinds.indexOf('booking') >= 0) { %><a class="btn secondary small" href="/go/<%= entity.slug %>/<%= g.code %>" rel="sponsored nofollow noopener" target="_blank" data-goal="Partnerlink" data-goal-prop-anbieter="<%= g.name %>" data-goal-prop-art="Preise"><%= g.label_booking %> ↗</a><% } %>
              <% if (g.kinds.indexOf('reviews') >= 0) { %><a class="btn secondary small" href="/go/<%= entity.slug %>/<%= g.code %>/bewertungen" rel="sponsored nofollow noopener" target="_blank" data-goal="Partnerlink" data-goal-prop-anbieter="<%= g.name %>" data-goal-prop-art="Bewertungen"><%= g.label_reviews %> ↗</a><% } %>
            </li>
          <% }) %>
        </ul>
        <p class="muted" style="margin-bottom:0"><small><%= anyAd ? 'Bei einer Buchung über diese Links erhalten wir eine Provision. ' : '' %>Anbieter alphabetisch – auf <%= ranking.score_name %> und Reihenfolge hat das keinen Einfluss. Bewertungen dort stammen von den Anbietern und sind nicht Teil unseres Scores.</small></p>
      </div>
    <% } %>

    <% if (climate.length) { %>
      <h2 id="klima">Klima je Monat</h2>
      <p class="best-time-line"><span class="bt-label">Beste Reisezeit</span> <strong><%= bestTime || 'keine Monate mit idealem Trainingsklima' %></strong><% if (bestTimeRule) { %> <small class="muted">· Ø <%= bestTimeRule.min %>–<%= bestTimeRule.max %> °C Tageshöchstwert</small><% } %></p>
      <div class="table-scroll">
        <table class="climate">
          <tr><th></th><% climate.forEach(function (c) { %><th class="<%= bestMonths.indexOf(c.month) >= 0 ? 'sel' : '' %>"><%= MONTHS[c.month - 1].slice(0, 3) %></th><% }) %></tr>
          <tr><th>Ø max °C</th><% climate.forEach(function (c) { %><td class="<%= bestMonths.indexOf(c.month) >= 0 ? 'sel' : '' %>"><%= c.avg_high_c === null ? '–' : Math.round(c.avg_high_c) %></td><% }) %></tr>
          <tr><th>Ø min °C</th><% climate.forEach(function (c) { %><td class="<%= bestMonths.indexOf(c.month) >= 0 ? 'sel' : '' %>"><%= c.avg_low_c === null ? '–' : Math.round(c.avg_low_c) %></td><% }) %></tr>
          <tr><th>Regentage</th><% climate.forEach(function (c) { %><td class="<%= bestMonths.indexOf(c.month) >= 0 ? 'sel' : '' %>"><%= c.rain_days === null ? '–' : Math.round(c.rain_days) %></td><% }) %></tr>
        </table>
      </div>
      <p class="muted"><small>Quelle: Open-Meteo, Mittel der letzten drei Jahre. Markiert: beste Reisezeit. Das Klima fließt nicht in den <%= ranking.score_name %> ein.</small></p>
    <% } %>

    <% if (entity.lat && entity.lng) { %>
      <h2>Lage</h2>
      <div class="map-box" id="map" data-lat="<%= entity.lat %>" data-lng="<%= entity.lng %>" data-name="<%= entity.name %>">
        <div>
          <p>Die Karte wird von OpenStreetMap geladen. Dabei wird deine IP-Adresse an deren Server übertragen.</p>
          <button class="btn small" type="button" id="load-map">Karte laden</button>
          <p><a href="https://www.openstreetmap.org/?mlat=<%= entity.lat %>&mlon=<%= entity.lng %>#map=13/<%= entity.lat %>/<%= entity.lng %>" target="_blank" rel="noopener">Auf OpenStreetMap öffnen</a></p>
        </div>
      </div>
    <% } %>

    <% if (gEmbed) { %>
      <h2 id="google">Google-Bewertungen</h2>
      <p class="muted" style="margin-top:0"><small>Allgemeine Gästemeinungen – nicht Teil des <%= ranking.score_name %>.</small></p>
      <div class="map-box g-embed" data-src="<%= gEmbed %>">
        <div>
          <p>Bewertungen und Karte werden von Google geladen. Dabei werden deine IP-Adresse an Google übertragen und Cookies gesetzt.</p>
          <button class="btn small" type="button" data-load-google>Google-Bewertungen laden</button>
          <p><a href="<%= googleMapsUrl(entity) %>" target="_blank" rel="nofollow noopener">Direkt bei Google ansehen ↗</a> · <a href="/datenschutz#google">Datenschutz</a></p>
        </div>
      </div>
      <% var reviewPartners = partnerGroups.filter(function (g) { return g.kinds.indexOf('reviews') >= 0; }); %>
      <% if (reviewPartners.length) { %>
        <p class="muted partner-reviews"><small>Weitere Gästebewertungen<%= reviewPartners.some(function (g) { return g.monetized; }) ? ' (Anzeige)' : '' %>: <% reviewPartners.forEach(function (g, i) { %><%= i ? ' · ' : '' %><a href="/go/<%= entity.slug %>/<%= g.code %>/bewertungen" rel="sponsored nofollow noopener" target="_blank" data-goal="Partnerlink" data-goal-prop-anbieter="<%= g.name %>" data-goal-prop-art="Bewertungen"><%= g.name %> ↗</a><% }) %></small></p>
      <% } %>
    <% } %>
  </section>
</div>

<% if (reviewCfg.enabled) { var starStr = function (v) { var n = Math.round(v || 0); return '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n); }; %>
  <section id="bewertungen" style="margin-top:24px">
    <div class="facts-head">
      <h2>Athleten-Bewertungen<% if (reviewList.length) { %> <small class="muted">· <%= String(reviewAvg === null ? '' : reviewAvg.toFixed(1)).replace('.', ',') %> von 5 aus <%= reviewList.length %> <%= reviewList.length === 1 ? 'Bewertung' : 'Bewertungen' %></small><% } %></h2>
      <a class="btn small cta" href="/<%= ranking.entity_type %>/<%= entity.slug %>/bewerten">Bewertung schreiben</a>
    </div>
    <% if (!reviewList.length) { %>
      <p class="muted">Noch keine Bewertungen. Warst du zum Training hier? Erzähl anderen, wie es war.</p>
    <% } else { %>
      <div class="review-summary">
        <% reviewDims.filter(function (d) { return d.avg !== null }).forEach(function (d) { %><div><span><%= d.label %></span><span><span class="star-line" aria-hidden="true"><%= starStr(d.avg) %></span> <%= String(d.avg).replace('.', ',') %></span></div><% }) %>
      </div>
      <% reviewList.forEach(function (r) { var vals = Object.values(r.ratings || {}); var avg = vals.reduce(function (a, b) { return a + Number(b) }, 0) / (vals.length || 1); %>
        <article class="review">
          <div class="meta"><span class="star-line" aria-label="<%= String(avg.toFixed(1)).replace('.', ',') %> von 5"><%= starStr(avg) %></span> · <strong><%= r.author_name %></strong> · Aufenthalt <%= new Date(r.stay_month).toLocaleDateString('de-DE', { month: 'long', year: 'numeric' }) %><% if (r.camp_name) { %> · mit <a href="/trainingscamp/anbieter/<%= r.camp_slug %>"><%= r.camp_name %></a><% } %></div>
          <% if (r.title) { %><h3><%= r.title %></h3><% } %>
          <p style="margin:6px 0 0;white-space:pre-line"><%= r.body %></p>
          <% if (r.images.length) { %><div class="review-photos"><% r.images.forEach(function (i) { var w = i.variants.includes(640) ? 640 : i.variants[0]; var big = i.variants[i.variants.length - 1]; %><a href="/media/review/<%= i.id %>-<%= big %>.webp" target="_blank" rel="noopener"><img src="/media/review/<%= i.id %>-<%= w %>.webp" alt="Foto von <%= r.author_name %>" loading="lazy" width="120" height="90"></a><% }) %></div><% } %>
          <% if (r.hotel_reply) { %><div class="reply"><strong>Antwort des <%= ranking.entity_label_sg %>s:</strong> <%= r.hotel_reply %></div><% } %>
        </article>
      <% }) %>
    <% } %>
    <p class="muted"><small>So prüfen wir Bewertungen: Jede Bewertung braucht eine bestätigte E-Mail-Adresse und den Monat des Aufenthalts; wir lesen jede Bewertung vor der Freigabe und veröffentlichen nur Erfahrungen, die von Gästen stammen. Bewertungen gegen Gegenleistung oder von Mitarbeitenden sind ausgeschlossen. <% if (athleteEnabled) { %>Ab <%= minReviews %> Bewertungen fließen sie mit <%= Math.round(athleteWeight * 100) %> % in den <%= ranking.score_name %> ein<%= athleteUsed ? ' – hier bereits der Fall' : '' %>.<% } else { %>Bewertungen fließen derzeit nicht in den <%= ranking.score_name %> ein.<% } %> <a href="<%= scorePath %>">Methodik</a></small></p>
  </section>
<% } %>

<% if (nearby.length) { %>
  <section>
    <h2>Weitere <%= ranking.entity_label_pl %> <%= region.name_in %></h2>
    <ul class="rank-list">
      <% nearby.forEach(function (e) { %>
        <li><a class="rank-item" href="<%= entityPath(e) %>"><span class="pos"><%= e.rank %></span><span class="info"><span class="name"><%= e.name %></span><br><small><%= e.city %> · <%= e.label %></small></span><span class="score"><%= e.score %></span></a></li>
      <% }) %>
    </ul>
    <p><a href="<%= base %>/region/<%= region.slug %>">Alle <%= ranking.entity_label_pl %> <%= region.name_in %> →</a></p>
  </section>
<% } %>

<% locals.scripts = ['/static/js/site.js'] %>
<%- include('../partials/foot') %>
