<%- include('../partials/head') %>

<% var pageImg = siteMedia.slots.submit; %>
<% if (pageImg) { %>
  <figure class="page-photo">
    <img <%- imgAttrs(pageImg) %> sizes="(max-width: 1200px) 100vw, 1200px" alt="<%= pageImg.alt %>" fetchpriority="high">
    <figcaption class="photo-credit"><%= pageImg.credit %></figcaption>
  </figure>
<% } %>
<h1><%= ranking.entity_label_sg %> hinzufügen</h1>
<p class="lead">Du kennst ein <%= ranking.entity_label_sg %>, das ins Ranking gehört? Wir prüfen jeden Vorschlag, bevor er online geht. Du bekommst eine Mail mit Bestätigungslink.</p>

<% if (errors.length) { %>
  <div class="errors"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="post" class="card" enctype="multipart/form-data" novalidate>
  <div class="form-row">
    <div><label for="name">Name *</label><input id="name" name="name" type="text" required maxlength="200" value="<%= form.name || '' %>"></div>
    <div><label for="website">Website *</label><input id="website" name="website" type="url" required placeholder="https://" value="<%= form.website || '' %>"></div>
  </div>
  <div class="form-row">
    <div><label for="city">Ort *</label><input id="city" name="city" type="text" required maxlength="120" value="<%= form.city || '' %>"></div>
    <div>
      <label for="country">Land *</label>
      <select id="country" name="country" required>
        <option value="">bitte wählen</option>
        <% COUNTRIES.forEach(function (c) { %><option value="<%= c[0] %>" <%= form.country === c[0] ? 'selected' : '' %>><%= c[1] %></option><% }) %>
      </select>
    </div>
  </div>

  <% if (askCriteria.length) { %>
    <h3>Was weißt du schon? <small class="muted">optional</small></h3>
    <div class="form-row">
      <% askCriteria.forEach(function (c) { var cur = (form.hints || {})[c.code]; %>
        <div>
          <label for="hint_<%= c.code %>"><%= c.label %></label>
          <select id="hint_<%= c.code %>" name="hint_<%= c.code %>">
            <option value="">weiß nicht</option>
            <% if (c.scoring.type === 'bool') { %>
              <option value="true" <%= cur === 'true' ? 'selected' : '' %>>ja</option>
              <option value="false" <%= cur === 'false' ? 'selected' : '' %>>nein</option>
            <% } else { Object.keys(c.scoring.points).forEach(function (k) { %>
              <option value="<%= k %>" <%= cur === k ? 'selected' : '' %>><%= (c.scoring.labels && c.scoring.labels[k]) || k %></option>
            <% }) } %>
          </select>
        </div>
      <% }) %>
    </div>
  <% } %>

  <label for="notes">Hinweise <small class="muted">optional</small></label>
  <textarea id="notes" name="notes" maxlength="2000"><%= form.notes || '' %></textarea>

  <div class="form-row">
    <div><label for="email">Deine E-Mail *</label><input id="email" name="email" type="email" required value="<%= form.email || '' %>"></div>
    <div>
      <label for="role">Du bist … <small class="muted">optional</small></label>
      <select id="role" name="role">
        <option value="">keine Angabe</option>
        <% Object.keys(roles).forEach(function (k) { %><option value="<%= k %>" <%= form.role === k ? 'selected' : '' %>><%= roles[k] %></option><% }) %>
      </select>
    </div>
  </div>

  <% if (reviewCfg && reviewCfg.enabled) { var rv = form.review || {}; %>
    <details class="submit-review" id="bewerten" <%= form.withReview ? 'open' : '' %> data-review-box>
      <summary><strong>Warst du schon dort? Dann bewerte das <%= ranking.entity_label_sg %> gleich mit</strong> <small class="muted">optional</small></summary>
      <p class="muted" data-owner-note hidden><small>Für Betreiber und Mitarbeiter ist keine Bewertung möglich.</small></p>
      <div data-review-fields>
        <label class="inline"><input type="checkbox" name="with_review" <%= form.withReview ? 'checked' : '' %>> <span>Ja, ich gebe eine Bewertung ab</span></label>
        <p class="muted" style="margin-top:0"><small>Sie erscheint erst, wenn das <%= ranking.entity_label_sg %> online ist und wir sie geprüft haben. Der Bestätigungslink gilt für beides.</small></p>
        <div class="form-row">
          <div><label for="rv-name">Dein Name * <small class="muted">so steht er über der Bewertung, z. B. „Anna K.“</small></label><input id="rv-name" name="author_name" type="text" maxlength="40" value="<%= rv.author_name || '' %>" autocomplete="given-name"></div>
          <div><label for="rv-month">Aufenthalt *</label>
            <select id="rv-month" name="stay_month"><option value="">Monat wählen</option><% months.forEach(function (m) { %><option value="<%= m.value %>" <%= rv.stay_month === m.value ? 'selected' : '' %>><%= m.label %></option><% }) %></select></div>
        </div>
        <% if (camps.length) { %>
          <label for="rv-camp">Mit Camp-Anbieter? <small class="muted">optional</small></label>
          <select id="rv-camp" name="camp_provider_id"><option value="">nein / auf eigene Faust</option><% camps.forEach(function (c) { %><option value="<%= c.id %>" <%= rv.camp_provider_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select>
        <% } %>
        <p class="muted" style="margin:12px 0 0"><small>Sterne: 1 = schlecht, 5 = hervorragend. Lass Bereiche aus, die du nicht beurteilen kannst (mindestens drei).</small></p>
        <div class="rating-grid">
          <% reviewCfg.dimensions.forEach(function (d) { var cur = String(rv['r_' + d.code] || ''); %>
            <fieldset class="stars">
              <legend><%= d.label %></legend>
              <% [5, 4, 3, 2, 1].forEach(function (n) { var id = 'r-' + d.code + '-' + n; %>
                <input type="radio" id="<%= id %>" name="r_<%= d.code %>" value="<%= n %>" <%= cur === String(n) ? 'checked' : '' %>><label for="<%= id %>" title="<%= n %> von 5">★</label>
              <% }) %>
            </fieldset>
          <% }) %>
        </div>
        <label for="rv-title">Überschrift <small class="muted">optional</small></label>
        <input id="rv-title" name="title" type="text" maxlength="120" value="<%= rv.title || '' %>">
        <label for="rv-body">Deine Erfahrung *</label>
        <textarea id="rv-body" name="body" rows="6" maxlength="4000" placeholder="Wie waren Pool, Strecken, Essen, Service für Sportler?"><%= rv.body || '' %></textarea>
        <label for="rv-photos">Fotos <small class="muted">optional, höchstens <%= MAX_PHOTOS %> (JPG, PNG, WebP, je bis 8 MB)<%= form.withReview && errors.length ? ' – bitte nach einem Fehler erneut auswählen' : '' %></small></label>
        <input id="rv-photos" type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple>
        <label class="inline"><input type="checkbox" name="photo_consent" <%= rv.photo_consent === 'on' ? 'checked' : '' %>> <span><%= PHOTO_CONSENT %></span></label>
        <label class="inline"><input type="checkbox" name="honest" <%= rv.honest === 'on' ? 'checked' : '' %>> <span>Ich war selbst dort, arbeite nicht für das <%= ranking.entity_label_sg %> und habe für diese Bewertung keine Gegenleistung erhalten. *</span></label>
        <p class="muted" style="margin-bottom:0"><small><a href="/datenschutz#bewertungen" target="_blank">Datenschutz bei Bewertungen</a></small></p>
      </div>
    </details>
  <% } %>

  <div class="hp" aria-hidden="true">
    <label for="company_url">Bitte leer lassen</label>
    <input id="company_url" name="company_url" type="text" tabindex="-1" autocomplete="off">
  </div>

  <label class="inline"><input type="checkbox" name="privacy" required>
    <span>Ich habe die <a href="/datenschutz#vorschlag" target="_blank">Datenschutzerklärung</a> gelesen. Meine E-Mail-Adresse wird nur für diesen Vorschlag verwendet. *</span></label>

  <p><button class="btn cta" type="submit">Vorschlag absenden</button></p>
</form>

<% locals.scripts = ['/static/js/site.js'] %>
<%- include('../partials/foot') %>
