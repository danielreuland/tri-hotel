<%# Morgenbericht (intern): Zahlen des Vortags je Seite. Als Liste statt Tabelle, damit auch die Textfassung lesbar bleibt. %>
<%- include('_layout_top') %>
<% function num(n) { return n === null || n === undefined ? 'k. A.' : Number(n).toLocaleString('de-DE'); } %>
<p>Zahlen für <strong><%= dayLabel %></strong></p>
<% sites.forEach(function (s) { %>
  <p style="font-weight:bold;margin:20px 0 4px"><%= s.label %></p>
  <ul style="list-style:none;margin:0;padding:0">
    <li>Unique Visitors: <strong><%= num(s.visitors) %></strong></li>
    <li>Seitenaufrufe: <strong><%= num(s.pageviews) %></strong></li>
    <li>Klicks auf <%= ranking.entity_label_pl %>: <strong><%= num(s.hotelClicks) %></strong></li>
    <li>Antworten von Betreibern: <strong><%= num(s.answersForm + s.answersMail) %></strong><% if (s.answersForm + s.answersMail) { %> (Formular <%= num(s.answersForm) %>, Mail <%= num(s.answersMail) %>)<% } %></li>
    <li>Partnerklicks: <strong><%= num(s.partnerClicks) %></strong></li>
    <li>Camp-Klicks: <strong><%= num(s.campClicks) %></strong></li>
  </ul>
  <% if (s.analytics === 'error') { %><p style="color:#57606a;font-size:13px;margin:4px 0">Plausible war nicht erreichbar, die Werte fehlen deshalb.</p><% } %>
  <% if (s.analytics === 'off') { %><p style="color:#57606a;font-size:13px;margin:4px 0">Plausible ist nicht eingerichtet.</p><% } %>
<% }) %>
<% var outs = locals.optOuts || []; if (outs.length) { %>
  <p style="font-weight:bold;margin:20px 0 4px">Abmeldungen von E-Mails: <%= outs.length %></p>
  <ul style="margin:0;padding-left:18px">
    <% outs.forEach(function (o) { %><li><%= o.name %> (<%= o.source === 'admin' ? 'im Admin eingetragen' : 'über den Abmeldelink' %>)</li><% }) %>
  </ul>
  <p style="color:#57606a;font-size:13px;margin:4px 0">An diese Betriebe gehen keine Anfragen und Erinnerungen mehr. Liste im Admin: Kommunikation → Anfragen → „abgemeldet“.</p>
<% } %>
<p style="color:#57606a;font-size:13px;margin-top:20px">Klicks auf <%= ranking.entity_label_pl %> sind Aufrufe der Objektseiten. Bei Seiten ohne eigene Objektseiten sind es Aufrufe auf <%= sites[0] ? sites[0].label : '' %> von Besuchern, die von dieser Seite kamen; bei <%= sites[0] ? sites[0].label : '' %> sind sie mitgezählt.</p>
<%- include('_layout_bottom') %>
