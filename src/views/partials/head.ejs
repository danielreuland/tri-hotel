<!doctype html>
<html lang="de" data-theme-default="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% var pageTitle = fitTitle(title, locals.site ? site.name : null);
     var metaDesc = locals.description ? fitDescription(description) : null;
     var canonicalUrl = locals.canonical || (locals.siteUrl && locals.path ? siteUrl + path : null);
     var ogImg = locals.ogImage || (locals.siteUrl ? siteUrl + '/og/start.png' : null); %>
  <title><%= pageTitle %></title>
  <% if (metaDesc) { %><meta name="description" content="<%= metaDesc %>"><% } %>
  <% if (canonicalUrl) { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>
  <% if ((typeof noindex !== 'undefined' && noindex) || locals.noindexAll) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <meta property="og:type" content="<%= locals.ogType || 'website' %>">
  <meta property="og:locale" content="de_DE">
  <% if (locals.site) { %><meta property="og:site_name" content="<%= site.name %>"><% } %>
  <meta property="og:title" content="<%= title %>">
  <% if (metaDesc) { %><meta property="og:description" content="<%= metaDesc %>"><% } %>
  <% if (canonicalUrl) { %><meta property="og:url" content="<%= canonicalUrl %>"><% } %>
  <% if (ogImg) { %><meta property="og:image" content="<%= ogImg %>"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta name="twitter:image" content="<%= ogImg %>"><% } %>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preload" href="/static/fonts/bebas-neue-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <% (locals.jsonLd || []).forEach(function (ld) { %><script type="application/ld+json"><%- ldJson(ld) %></script>
  <% }) %>
  <% if (locals.plausibleSrc && locals.site) { %><script defer data-domain="<%= site.primary_domain %>" src="<%= plausibleSrc %>"></script><% } %>
  <link rel="stylesheet" href="/static/css/style.css?v=<%= assetVersion %>">
  <script src="/static/js/theme.js?v=<%= assetVersion %>"></script>
  <% if (locals.siteCss) { %><style><%- siteCss %></style><% } %>
</head>
<body class="<%= locals.fullWidth ? 'landing' : '' %>">
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/"><%- include('logo') %></a>
    <nav>
      <% if (locals.hostRanking) { %>
        <a href="/#ranking">Ranking</a>
        <% if (locals.campGuide) { %><a href="/trainingscamp">Trainingscamps</a><% } %>
        <a class="nav-cta" href="/<%= hostRanking.entity_type %>-hinzufuegen"><%= hostRanking.entity_label_sg %> hinzufügen</a>
      <% } %>
      <%- include('theme-toggle') %>
    </nav>
  </div>
</header>
<main>
<% if (!locals.fullWidth) { %><div class="wrap"><% } %>
