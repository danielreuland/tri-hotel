<!doctype html>
<html lang="de" data-theme-default="system">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · Admin</title>
  <link rel="stylesheet" href="/static/css/style.css?v=<%= assetVersion %>">
  <script src="/static/js/theme.js?v=<%= assetVersion %>"></script>
  <script src="/static/js/confirm.js?v=<%= assetVersion %>" defer></script>
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/admin/aufgaben">RANKING<span>-</span>ADMIN</a>
    <% if (locals.admin) { var nav = locals.adminNav || { sections: [], counts: {} }; %>
      <nav class="admin-nav" aria-label="Bereiche">
        <% nav.sections.forEach(function (s) { var n = nav.counts[s.key]; %>
          <a href="<%= s.tabs[0].href %>" class="<%= nav.section === s.key ? 'on' : '' %>" <%= nav.section === s.key ? 'aria-current=page' : '' %>><%= s.label || nav.objectsLabel %><% if (n) { %> <span class="nav-count"><%= n %></span><% } %></a>
        <% }) %>
      </nav>
      <div class="admin-tools">
        <a href="/" target="_blank" title="Website öffnen" aria-label="Website öffnen">Website ↗</a>
        <%- include('theme-toggle') %>
        <details class="admin-user">
          <summary title="<%= admin.email %>"><%= (admin.email || '?').slice(0, 1).toUpperCase() %></summary>
          <div class="admin-user-menu">
            <small class="muted"><%= admin.email %></small>
            <form method="post" action="/admin/logout"><button class="btn small secondary" type="submit">Abmelden</button></form>
          </div>
        </details>
      </div>
    <% } else { %>
      <%- include('theme-toggle') %>
    <% } %>
  </div>
</header>
<main>
<div class="wrap">
<% if (locals.admin && locals.adminNav && adminNav.section) { var cur = adminNav.sections.find(function (s) { return s.key === adminNav.section; }); if (cur.tabs.length > 1) { %>
  <nav class="admin-subnav" aria-label="<%= cur.label || adminNav.objectsLabel %>">
    <% cur.tabs.forEach(function (t) { %><a href="<%= t.href %>" class="<%= adminNav.tab === t.href ? 'on' : '' %>"><%= t.label %></a><% }) %>
  </nav>
<% } } %>
<% if (locals.flash) { %><div class="flash"><%= flash %></div><% } %>
<% if (locals.error) { %><div class="errors"><%= error %></div><% } %>
