<%# Vorschaubild in Ranking-Listen (e.thumb aus rankings.listLive), Urhebervermerk immer sichtbar.
    Beispielbilder der Region sind als „Symbolbild“ gekennzeichnet (Alt-Text leer, da dekorativ); ohne Bild ein neutraler Platzhalter %>
<span class="thumb<%= e.thumb && e.thumb.example ? ' example' : '' %>">
  <% if (e.thumb) { %>
    <img src="<%= e.thumb.src %>" srcset="<%= e.thumb.srcset %>" sizes="112px" width="<%= e.thumb.width %>" height="<%= e.thumb.height %>" alt="<%= e.thumb.example ? '' : e.name + (e.city ? ', ' + e.city : '') %>"
      loading="lazy"<% if (e.thumb.focal) { %> style="object-position:<%= String(e.thumb.focal).replace(/[^0-9% .a-z-]/gi, '') %>"<% } %>>
    <% if (e.thumb.example) { %><span class="thumb-badge" title="Symbolbild der Region <%= e.thumb.example %>, kein Foto dieses Eintrags">Symbolbild</span><% } %>
    <small class="thumb-credit" title="<%= e.thumb.credit %>"><%= e.thumb.credit %></small>
  <% } else { %>
    <span class="thumb-empty" aria-hidden="true"><%= String(e.name || '').trim().charAt(0).toUpperCase() %></span>
  <% } %>
</span>
